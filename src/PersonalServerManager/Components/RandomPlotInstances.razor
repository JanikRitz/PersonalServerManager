@using System.Text.Json
@using PersonalServerManager.Management
@using PersonalServerManager.RandomPlot
@implements IDisposable
@inject IRandomPlotInstanceStore Store
@inject IRandomPlotClient Client
@inject ManagedBackendService ManagedBackends
@inject IJSRuntime JavaScript

<section class="backend-group randomplot-instances" aria-labelledby="randomplot-heading">
    <div class="section-heading">
        <h2 id="randomplot-heading">RandomPlotGenerator</h2>
        <button class="icon-action" type="button" title="Add RandomPlotGenerator instance" aria-label="Add RandomPlotGenerator instance" disabled="@_busy" @onclick="() => OpenEditor(null)"><MudIcon Icon="@Icons.Material.Filled.Add" /></button>
    </div>
    @if (_error is not null) { <p role="alert">@_error</p> }
    @if (_loading) { <p class="empty-message" role="status">Loading RandomPlotGenerator instances...</p> }
    else if (_instances.Count == 0 && _error is null) { <p class="empty-message">No RandomPlotGenerator instances configured.</p> }
    <ul class="instance-list" aria-label="RandomPlotGenerator instances">
        @foreach (var instance in _instances)
        {
            var available = _availability.GetValueOrDefault(instance.Id);
            <li @key="instance.Id">
                <BackendInstanceRow Name="@instance.Name" Type="@(instance.IsManaged ? "Managed" : "External")" Status="@(available is true ? "Available" : available is false ? "Unavailable" : "Unknown")" StatusClass="@(available is true ? "online" : available is false ? "offline" : "unknown")"
                    Selected="@Selection.IsSelected("RandomPlotGenerator", instance.Id)" OnSelect='() => Selection.Select("RandomPlotGenerator", instance.Id)'>
                    <Actions>
                        @if (instance.IsManaged) { <ManagedBackendControls InstanceId="@instance.Id" InstanceName="@instance.Name" Compact="true" Disabled="@(_busy || _editing)" /> }
                    </Actions>
                </BackendInstanceRow>
            </li>
        }
    </ul>
</section>

@if (_instances.FirstOrDefault(instance => Selection.IsSelected("RandomPlotGenerator", instance.Id)) is { } selected)
{
    <section class="backend-details randomplot-details" aria-label="@($"RandomPlotGenerator details for {selected.Name}")">
        <h2>@selected.Name</h2>
        <dl>
            <dt>Mode</dt><dd>@(selected.IsManaged ? "Managed" : "External")</dd>
            <dt>API base URL</dt><dd>@selected.ApiBaseUrl.AbsoluteUri</dd>
            <dt>MCP URL</dt><dd>@selected.McpUrl.AbsoluteUri</dd>
            @if (selected.IsManaged) { <dt>Published folder</dt><dd>@selected.InstallationFolder</dd><dt>Data file</dt><dd>@(selected.DataFilePath ?? "Separate PSM-managed data")</dd> }
        </dl>
        <label for="randomplot-mcp-config">VS Code MCP configuration</label>
        <textarea id="randomplot-mcp-config" readonly rows="7" value="@McpConfiguration(selected)" aria-label="VS Code MCP configuration"></textarea>
        @if (selected.McpUrl.IsLoopback) { <p class="config-note">This localhost URL only works in VS Code running on the server host.</p> }
        @if (selected.IsManaged)
        {
            <ManagedBackendControls @key="selected.Id" InstanceId="@selected.Id" SettingsOnly="true" Disabled="@(_busy || _editing)" StartWithApp="@selected.StartWithApp" StartWithAppChanged="enabled => SaveAutostartAsync(selected, enabled)" />
        }
        <div class="detail-actions">
            <a href="@selected.BrowserUrl" target="_blank" rel="noopener noreferrer" aria-label="@($"Open RandomPlotGenerator {selected.Name}")"><MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /> Open</a>
            <button type="button" disabled="@_busy" @onclick="() => OpenEditor(selected)"><MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" /> Edit</button>
            <button type="button" disabled="@_busy" @onclick="() => RemoveAsync(selected)"><MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" /> Remove</button>
        </div>
    </section>
}

@if (_editing)
{
    <div class="editor-backdrop" role="presentation" @onclick="CloseEditor" @onkeydown="HandleEditorKey">
        <section class="editor-panel" role="dialog" aria-modal="true" aria-labelledby="randomplot-editor-title" @onclick:stopPropagation="true">
            <MudFocusTrap>
                <div class="editor-heading"><h3 id="randomplot-editor-title">@(_editingId is null ? "Add RandomPlotGenerator" : "Edit RandomPlotGenerator")</h3><button class="icon-action" type="button" title="Close editor" aria-label="Close RandomPlotGenerator editor" disabled="@_busy" @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Filled.Close" /></button></div>
                @if (_editorError is not null) { <p role="alert">@_editorError</p> }
                <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                    <fieldset disabled="@_busy">
                        <label>Instance name<input @bind="_name" maxlength="60" required autofocus /></label>
                        <div class="mode-selector" role="radiogroup" aria-label="RandomPlotGenerator mode">
                            <label><input type="radio" name="randomplot-mode" checked="@(!_managed)" @onchange="() => _managed = false" /> External</label>
                            <label><input type="radio" name="randomplot-mode" checked="@_managed" @onchange="() => _managed = true" /> Managed</label>
                        </div>
                        @if (_managed)
                        {
                            <label>Published folder<input @bind="_folder" required placeholder="C:\Servers\RandomPlotGenerator" /></label>
                            <label>Existing data file (optional)<input @bind="_dataFile" placeholder="C:\Servers\RandomPlotGenerator\random-plot-generator-data.json" /></label>
                            <p class="config-note">Leave blank for separate PSM-managed data. An existing file is used directly and changes made in RandomPlotGenerator are saved to it; back it up first and do not share it between running instances.</p>
                            <label>Port<input type="number" min="1" max="65535" @bind="_port" required /></label>
                            <label class="checkbox"><input type="checkbox" @bind="_autostart" /> Start with Personal Server Manager</label>
                        }
                        else { <label>Base URL<input type="url" @bind="_url" required placeholder="http://localhost:5243/" /></label> }
                        <div class="editor-actions"><button class="cancel-button" type="button" @onclick="CloseEditor">Cancel</button><button class="save-button" type="submit">@(_busy ? "Saving..." : "Save instance")</button></div>
                    </fieldset>
                </form>
            </MudFocusTrap>
        </section>
    </div>
}

@code {
    [CascadingParameter] public BackendSelection Selection { get; set; } = null!;
    [Parameter] public EventCallback<int> CountChanged { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private readonly Dictionary<Guid, bool?> _availability = [];
    private readonly Dictionary<Guid, ManagedBackendStatus> _managedStatuses = [];
    private IReadOnlyList<RandomPlotInstance> _instances = [];
    private bool _loading = true, _busy, _editing, _managed, _autostart;
    private bool _disposed;
    private int _observationVersion;
    private Guid? _editingId;
    private string _name = "", _url = "http://localhost:5243/", _folder = "", _dataFile = "";
    private int _port = 5243;
    private string? _error, _editorError;

    protected override async Task OnInitializedAsync()
    {
        Selection.Changed += SelectionChanged;
        await ReloadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ = ObservePeriodicallyAsync();
        return Task.CompletedTask;
    }

    private void SelectionChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task ReloadAsync()
    {
        try
        {
            _instances = await Store.GetAllAsync(_lifetime.Token);
            _observationVersion++;
            _availability.Clear();
            _managedStatuses.Clear();
            foreach (var instance in _instances.Where(instance => instance.IsManaged))
                _managedStatuses[instance.Id] = ManagedBackends.GetStatus(instance.Id);
            await CountChanged.InvokeAsync(_instances.Count);
            _error = null;
            await RefreshAvailabilityAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UnauthorizedAccessException)
        { _error = "Could not load RandomPlotGenerator instances."; }
        finally { _loading = false; }
    }

    private async Task RefreshAvailabilityAsync()
    {
        var snapshot = _instances;
        var version = ++_observationVersion;
        var results = await Task.WhenAll(snapshot.Select(async instance =>
        {
            try
            {
                await Client.GetGroupsAsync(instance, "", _lifetime.Token);
                return (instance.Id, Available: true);
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { throw; }
            catch (Exception exception) when (exception is HttpRequestException or IOException or InvalidDataException or JsonException or NotSupportedException or OperationCanceledException or TimeoutException)
            { return (instance.Id, Available: false); }
        }));
        if (!_disposed && version == _observationVersion && ReferenceEquals(snapshot, _instances))
            foreach (var result in results) _availability[result.Id] = result.Available;
    }

    private async Task ObservePeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var ticks = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(async () =>
                {
                    if (_disposed || _busy || _loading) return;
                    var changed = false;
                    foreach (var instance in _instances.Where(instance => instance.IsManaged))
                    {
                        var status = ManagedBackends.GetStatus(instance.Id);
                        var previous = _managedStatuses.GetValueOrDefault(instance.Id);
                        if (ReferenceEquals(previous, status) || (!status.IsRunning && status == previous)) continue;
                        _managedStatuses[instance.Id] = status;
                        _availability.Remove(instance.Id);
                        _observationVersion++;
                        changed = true;
                    }
                    if (changed) StateHasChanged();
                    if (changed || ++ticks >= 5)
                    {
                        ticks = 0;
                        await RefreshAvailabilityAsync();
                        if (!_disposed) StateHasChanged();
                    }
                });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (_disposed) { }
    }

    private void OpenEditor(RandomPlotInstance? instance)
    {
        if (instance is not null && ManagedBackends.GetStatus(instance.Id).IsRunning)
        { _error = "Stop RandomPlotGenerator before editing its configuration."; return; }
        _editingId = instance?.Id;
        _name = instance?.Name ?? "";
        _managed = instance?.IsManaged ?? false;
        _url = instance is { IsManaged: false } ? instance.BaseUrl.AbsoluteUri : "http://localhost:5243/";
        _folder = instance?.InstallationFolder ?? "";
        _dataFile = instance?.DataFilePath ?? "";
        _port = instance?.Port ?? 5243;
        _autostart = instance?.StartWithApp ?? false;
        _editorError = null;
        _editing = true;
    }

    private void CloseEditor() { if (!_busy) _editing = false; }
    private void HandleEditorKey(KeyboardEventArgs args) { if (args.Key == "Escape") CloseEditor(); }
    private static string McpConfiguration(RandomPlotInstance instance) => JsonSerializer.Serialize(
        new { servers = new Dictionary<string, object> { ["randomplot"] = new { type = "http", url = instance.McpUrl.AbsoluteUri } } },
        new JsonSerializerOptions { WriteIndented = true });

    private async Task SaveAsync()
    {
        if (_busy) return;
        if (_managed && string.IsNullOrWhiteSpace(_folder))
        { _editorError = "Enter a published folder."; return; }
        if (!Uri.TryCreate(_managed ? $"http://127.0.0.1:{_port}/" : _url.Trim(), UriKind.Absolute, out var url))
        { _editorError = "Enter a valid HTTP(S) URL or port."; return; }
        _busy = true;
        try
        {
            var instance = new RandomPlotInstance(_editingId ?? Guid.NewGuid(), _name, url, _managed ? _folder : null, _port, _autostart, _managed ? _dataFile : null);
            if (_editingId is null) await Store.SaveAsync(instance, _lifetime.Token);
            else await ManagedBackends.UpdateInstanceAsync(instance, _lifetime.Token);
            _editing = false;
            await ReloadAsync();
        }
        catch (InvalidDataException exception) { _editorError = exception.Message; }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException)
        { _editorError = "Could not save this instance. Check configuration file access."; }
        finally { _busy = false; }
    }

    private async Task SaveAutostartAsync(RandomPlotInstance instance, bool enabled)
    {
        try { await Store.UpdateAsync(instance with { StartWithApp = enabled }, _lifetime.Token); await ReloadAsync(); }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UnauthorizedAccessException)
        { _error = "Could not save the autostart setting."; }
    }

    private async Task RemoveAsync(RandomPlotInstance instance)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            if (!await JavaScript.InvokeAsync<bool>("confirm", _lifetime.Token, $"Remove {instance.Name}? Managed processes will be stopped; data will be kept.")) return;
            await ManagedBackends.RemoveInstanceAsync("RandomPlotGenerator", instance.Id, _lifetime.Token);
            Selection.Clear("RandomPlotGenerator", instance.Id);
            await ReloadAsync();
        }
        catch (InvalidDataException exception) { _error = exception.Message; }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or JSException)
        { _error = "Could not remove this instance."; }
        finally { _busy = false; }
    }

    public void Dispose()
    {
        _disposed = true;
        Selection.Changed -= SelectionChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}