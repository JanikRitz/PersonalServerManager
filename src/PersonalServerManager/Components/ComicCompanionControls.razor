@using System.Text.Json
@using PersonalServerManager.Management
@inject IServiceProvider Services
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

@if (_service is not null)
{
    <section class="backend-group comic-instances" aria-labelledby="comic-companion-heading" aria-busy="@_busy">
        <div class="section-heading">
            <h2 id="comic-companion-heading">Comic Companion</h2>
            <button class="icon-action" type="button" title="Add Comic Companion instance" aria-label="Add Comic Companion instance" disabled="@(_busy || !_loaded)" @onclick="() => OpenEditor(null)"><MudIcon Icon="@Icons.Material.Filled.Add" /></button>
        </div>
        @if (_error is not null)
        {
            <p role="alert">@_error</p>
        }
        @if (!_loaded && _error is null)
        {
            <p class="empty-message" role="status">Loading Comic Companion instances...</p>
        }
        else if (_loaded && _instances.Count == 0 && _error is null)
        {
            <p class="empty-message">No Comic Companion instances configured.</p>
        }
        <ul class="instance-list" aria-label="Comic Companion instances">
            @foreach (var instance in _instances)
            {
                var status = _service.GetStatus(instance.Id);
                _catalogAvailability.TryGetValue(instance.Id, out var available);
                <li @key="instance.Id">
                    <BackendInstanceRow Name="@instance.Name" Type="@(instance.IsManaged ? "Managed" : "External")"
                        Status="@(available is true ? "Available" : available is false ? "Unavailable" : "Unknown")"
                        StatusClass="@(available is true ? "online" : available is false ? "offline" : "unknown")"
                        Selected="@Selection.IsSelected("Comic Companion", instance.Id)" OnSelect='() => Selection.Select("Comic Companion", instance.Id)'>
                        <Actions>
                        @if (instance.IsManaged)
                        {
                            <span class="backend-process-status" role="status">@(status.IsRunning ? "Running" : "Stopped")</span>
                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" title="Start" aria-label="@($"Start {instance.Name}")" Disabled="@(_busy || _draft is not null || status.IsRunning)" OnClick="() => RunAsync(() => _service.StartInstanceAsync(instance.Id, _lifetime.Token))" Size="Size.Small" />
                            <MudIconButton Icon="@Icons.Material.Filled.Stop" title="Stop" aria-label="@($"Stop {instance.Name}")" Disabled="@(_busy || _draft is not null || !status.IsRunning)" OnClick="() => RunAsync(() => _service.StopInstanceAsync(instance.Id))" Size="Size.Small" />
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="Restart" aria-label="@($"Restart {instance.Name}")" Disabled="@(_busy || _draft is not null || !status.IsRunning)" OnClick="() => RunAsync(() => _service.RestartInstanceAsync(instance.Id, _lifetime.Token))" Size="Size.Small" />
                        }
                        </Actions>
                    </BackendInstanceRow>
                </li>
            }
        </ul>
        @if (_draft is { } draft)
        {
            <div class="editor-backdrop" role="presentation" @onclick="CloseEditor" @onkeydown="HandleEditorKey">
                <section class="editor-panel" role="dialog" aria-modal="true" aria-labelledby="comic-editor-title" @onclick:stopPropagation>
                    <MudFocusTrap>
                        <div class="editor-heading">
                            <h3 id="comic-editor-title">@(_instances.Any(instance => instance.Id == draft.Id) ? "Edit Comic Companion" : "Add Comic Companion")</h3>
                            <button class="icon-action" type="button" title="Close Comic Companion editor" aria-label="Close Comic Companion editor" disabled="@_busy" @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Filled.Close" /></button>
                        </div>
                        @if (_editorError is not null)
                        {
                            <p role="alert">@_editorError</p>
                        }
                        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
                            <fieldset disabled="@_busy">
                                <label>Instance name <input @ref="_nameInput" @bind="_name" maxlength="60" required /></label>
                                <div class="mode-selector" role="radiogroup" aria-label="Comic Companion mode">
                                    <label><input type="radio" name="comic-mode" checked="@(!_managed)" @onchange="() => _managed = false" /> External</label>
                                    <label><input type="radio" name="comic-mode" checked="@_managed" @onchange="() => _managed = true" /> Managed</label>
                                </div>
                                <label>API base URL <input type="url" @bind="_apiUrl" placeholder="http://127.0.0.1:5053/" required /></label>
                                <label>Browser URL (optional) <input type="url" @bind="_browserUrl" /></label>
                                @if (_managed)
                                {
                                    <label>Installation folder <input @bind="_folder" required /></label>
                                    <label class="checkbox"><input type="checkbox" @bind="_autostart" /> Start with Personal Server Manager</label>
                                    <label class="checkbox"><input type="checkbox" @bind="_automaticSync" /> Automatic sync</label>
                                    @if (_automaticSync)
                                    {
                                        <label>Sync interval (minutes) <input type="number" min="1" max="35791" required @bind="_syncMinutes" /></label>
                                    }
                                }
                                <div class="editor-actions">
                                    <button class="cancel-button" type="button" @onclick="CloseEditor">Cancel</button>
                                    <button class="save-button" type="submit">@(_busy ? "Saving..." : "Save instance")</button>
                                </div>
                            </fieldset>
                        </form>
                    </MudFocusTrap>
                </section>
            </div>
        }
    </section>
    @if (_instances.FirstOrDefault(instance => Selection.IsSelected("Comic Companion", instance.Id)) is { } selected)
    {
        var status = _service.GetStatus(selected.Id);
        _catalogAvailability.TryGetValue(selected.Id, out var available);
        <section class="backend-details comic-details" aria-label="@($"{selected.Name} details")">
            <h2>@selected.Name</h2>
            <dl>
                <dt>Type</dt><dd>@(selected.IsManaged ? "Managed" : "External")</dd>
                <dt>API URL</dt><dd>@selected.ApiUrl?.AbsoluteUri</dd>
                <dt>Browser URL</dt><dd>@selected.EffectiveBrowserUrl?.AbsoluteUri</dd>
                <dt>Catalog API</dt><dd role="status">@(available is true ? "Available" : available is false ? "Unavailable" : "Unknown")</dd>
                @if (selected.IsManaged)
                {
                    <dt>Process</dt><dd role="status">@status.Message</dd>
                    <dt>Installation</dt><dd>@selected.InstallationFolder</dd>
                    <dt>Start with app</dt><dd>@(selected.StartWithApp ? "Yes" : "No")</dd>
                    <dt>Automatic sync</dt><dd>@(selected.AutomaticSync ? $"Every {selected.SyncIntervalMinutes} minutes" : "Off")</dd>
                }
            </dl>
            <div class="actions detail-actions">
                @if (selected.EffectiveBrowserUrl is { } browser)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Href="@selected.BrowserLink(browser).ToString()" Target="_blank" rel="noopener noreferrer" title="Open in new tab" aria-label="@($"Open {selected.Name}")" Size="Size.Small" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Edit" title="Edit" aria-label="@($"Edit {selected.Name}")" Disabled="@(_busy || _draft is not null || status.IsRunning)" OnClick="() => OpenEditor(selected)" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" title="Remove" aria-label="@($"Remove {selected.Name}")" Color="Color.Error" Disabled="@(_busy || _draft is not null)" OnClick="() => RemoveAsync(selected)" Size="Size.Small" />
            </div>
        </section>
    }
}

@code {
    [CascadingParameter] public BackendSelection Selection { get; set; } = null!;
    [Parameter] public EventCallback<int> CountChanged { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private ComicCompanionService? _service;
    private ComicCompanionCatalogProbe? _catalogProbe;
    private IReadOnlyList<ComicCompanionSettings> _instances = [];
    private Dictionary<Guid, ManagedBackendStatus> _statuses = [];
    private Dictionary<Guid, bool?> _catalogAvailability = [];
    private ComicCompanionSettings? _draft;
    private Task? _refreshTask;
    private Task? _observationTask;
    private ElementReference _nameInput;
    private string? _name, _apiUrl, _browserUrl, _folder, _error, _editorError;
    private bool _managed, _autostart, _automaticSync, _busy, _loaded, _focusEditor;
    private int _syncMinutes = 60;

    protected override async Task OnInitializedAsync()
    {
        Selection.Changed += SelectionChanged;
        _service = Services.GetService<ComicCompanionService>();
        if (_service is null) return;
        await RunAsync(ReloadAsync);
    }

    private void SelectionChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _service is not null && !_lifetime.IsCancellationRequested)
        {
            _catalogProbe = Services.GetRequiredService<ComicCompanionCatalogProbe>();
            _refreshTask = RefreshAsync();
            _observationTask = ObserveCatalogPeriodicallyAsync();
        }
        if (_focusEditor && _draft is not null)
        {
            _focusEditor = false;
            await _nameInput.FocusAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _instances = await _service!.GetAllAsync(_lifetime.Token);
        _catalogAvailability.Clear();
        _statuses = ReadStatuses();
        _loaded = true;
        await CountChanged.InvokeAsync(_instances.Count);
        if (_observationTask is not null && !_lifetime.IsCancellationRequested)
        {
            StateHasChanged();
            await RefreshCatalogAvailabilityAsync();
        }
    }

    private void OpenEditor(ComicCompanionSettings? instance)
    {
        _draft = instance ?? new() { Id = Guid.NewGuid(), Name = string.Empty };
        _name = _draft.Name;
        _apiUrl = _draft.ApiUrl?.AbsoluteUri;
        _browserUrl = _draft.BrowserUrl?.AbsoluteUri;
        _folder = _draft.InstallationFolder;
        _managed = _draft.IsManaged;
        _autostart = _draft.StartWithApp;
        _automaticSync = _draft.AutomaticSync;
        _syncMinutes = _draft.SyncIntervalMinutes;
        _editorError = null;
        _focusEditor = true;
    }

    private void CloseEditor() { if (!_busy) _draft = null; }

    private void HandleEditorKey(KeyboardEventArgs args) { if (args.Key == "Escape") CloseEditor(); }

    private Dictionary<Guid, ManagedBackendStatus> ReadStatuses() =>
        _instances.ToDictionary(instance => instance.Id, instance => _service!.GetStatus(instance.Id));

    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(() =>
                {
                    var statuses = ReadStatuses();
                    if (statuses.All(entry => _statuses.GetValueOrDefault(entry.Key) == entry.Value)) return;
                    _statuses = statuses;
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private async Task ObserveCatalogPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            await RefreshCatalogAvailabilityAsync();
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                if (!_busy) await RefreshCatalogAvailabilityAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private async Task RefreshCatalogAvailabilityAsync()
    {
        var snapshot = _instances;
        var observations = await Task.WhenAll(snapshot.Select(async instance =>
            (instance.Id, Available: (bool?)await _catalogProbe!.IsAvailableAsync(instance, _lifetime.Token))));
        if (_lifetime.IsCancellationRequested || !ReferenceEquals(snapshot, _instances)) return;

        var availability = observations.ToDictionary(observation => observation.Id, observation => observation.Available);
        if (availability.Count == _catalogAvailability.Count &&
            availability.All(entry => _catalogAvailability.GetValueOrDefault(entry.Key) == entry.Value)) return;

        _catalogAvailability = availability;
        StateHasChanged();
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        if (_draft is not { } draft) return;
        if (_managed && string.IsNullOrWhiteSpace(_folder)) throw new InvalidDataException("Enter the installation folder.");
        var settings = new ComicCompanionSettings(ParseUrl(_apiUrl), ParseUrl(_browserUrl),
            _managed ? _folder : null, _autostart, _automaticSync, _syncMinutes) { Id = draft.Id, Name = _name ?? string.Empty };
        if (draft.ApiUrl is null) await _service!.SaveSettingsAsync(settings, _lifetime.Token);
        else await _service!.UpdateSettingsAsync(settings, _lifetime.Token);
        await ReloadAsync();
        _draft = null;
    }, editor: true);

    private Task RemoveAsync(ComicCompanionSettings instance) => RunAsync(async () =>
    {
        var consequence = instance.IsManaged ? "Its managed process will be stopped and local files will be kept." : "The external service will remain running and local files will be kept.";
        if (!await JavaScript.InvokeAsync<bool>("confirm", _lifetime.Token, $"Remove {instance.Name}? {consequence} Only its configuration will be removed.")) return;
        await _service!.RemoveSettingsAsync(instance.Id, _lifetime.Token);
        Selection.Clear("Comic Companion", instance.Id);
        await ReloadAsync();
    });

    private async Task RunAsync(Func<Task> action, bool editor = false)
    {
        if (_busy) return;
        _busy = true;
        SetError(null);
        try { await action(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (InvalidDataException exception) { SetError(exception.Message); }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException or JsonException or NotSupportedException or JSException)
        {
            SetError("Unable to read or save Comic Companion settings.");
        }
        finally
        {
            _statuses = ReadStatuses();
            _busy = false;
        }

        void SetError(string? message)
        {
            if (editor) _editorError = message;
            else _error = message;
        }
    }

    private static Uri? ParseUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        return Uri.TryCreate(value.Trim(), UriKind.Absolute, out var url)
            ? url : throw new InvalidDataException("Enter an absolute HTTP or HTTPS URL.");
    }

    public async ValueTask DisposeAsync()
    {
        Selection.Changed -= SelectionChanged;
        await _lifetime.CancelAsync();
        if (_refreshTask is not null) await _refreshTask;
        if (_observationTask is not null) await _observationTask;
        _lifetime.Dispose();
    }
}