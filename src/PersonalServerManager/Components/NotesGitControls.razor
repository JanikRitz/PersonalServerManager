@using PersonalServerManager.LocalLibraries
@implements IAsyncDisposable
@inject NotesGitSyncService GitSync

<div class="notes-git-controls" aria-busy="@(Busy ? "true" : "false")">
    <div class="sync-copy">
        <span class="sync-mode">Automatic Git sync @(Enabled ? "on" : "off")</span>
        <span class="sync-message" role="status">@_status.Message</span>
        <span class="sync-time">
            Last sync:
            @if (_status.LastSuccess is { } success)
            {
                <time datetime="@success.ToString("O")">@success.ToLocalTime().ToString("g")</time>
            }
            else
            {
                <span>Never</span>
            }
        </span>
        @if (_status.LastAttempt is { } attempt)
        {
            <span class="sync-time">Last attempt: <time datetime="@attempt.ToString("O")">@attempt.ToLocalTime().ToString("g")</time></span>
        }
    </div>
    <button class="sync-button" type="button" title="@(Busy ? "Sync in progress" : "Sync Notes")"
            aria-label="Sync Notes" disabled="@(Busy || InstanceId == Guid.Empty)" @onclick="PullAsync">
        <MudIcon Icon="@Icons.Material.Filled.Sync" aria-hidden="true" />
    </button>
</div>

@code {
    [Parameter] public Guid InstanceId { get; set; }
    [Parameter] public bool Enabled { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private NotesGitSyncStatus _status = new("Not synced yet.");
    private Task? _polling;
    private bool _busy;
    private bool _disposed;
    private bool Busy => _busy || _status.IsRunning;

    protected override void OnParametersSet() => _status = GitSync.GetStatus(InstanceId);

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _polling = ObserveStatusAsync(_lifetime.Token);
        return Task.CompletedTask;
    }

    private async Task PullAsync()
    {
        if (Busy || _disposed) return;
        _busy = true;
        try { await GitSync.PullAsync(InstanceId, _lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally
        {
            _busy = false;
            if (!_disposed) _status = GitSync.GetStatus(InstanceId);
        }
    }

    private async Task ObserveStatusAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(() =>
                {
                    if (_disposed) return;
                    var status = GitSync.GetStatus(InstanceId);
                    if (status == _status) return;
                    _status = status;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Cancel();
        if (_polling is not null) await _polling;
        _lifetime.Dispose();
    }
}