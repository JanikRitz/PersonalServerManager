@using PersonalServerManager.LocalLibraries
@using System.Text.Json
@implements IDisposable
@inject ILocalLibraryStore Store
@inject ManagedCalibreServer Calibre
@inject NotesGitSyncService GitSync
@inject IJSRuntime JavaScript
@inject PersonalServerManager.Hydrus.IHydrusInstanceStore HydrusStore
@inject PersonalServerManager.Stash.IStashInstanceStore StashStore

<section class="backend-group local-libraries" aria-labelledby="@FieldId("heading")">
    <header class="library-heading">
        <h2 id="@FieldId("heading")" tabindex="-1" @ref="_heading">@SectionTitle</h2>
        <button class="icon-button" type="button" title="@($"Add {SectionTitle} library")" aria-label="@($"Add {SectionTitle} library")" disabled="@(_busy || _loading || _editing)" @onclick="AddLibrary">
            <MudIcon Icon="@Icons.Material.Filled.Add" aria-hidden="true" />
        </button>
    </header>
    @if (_error is not null)
    {
        <p class="error-message" role="alert">@_error</p>
        <button class="retry-button" type="button" disabled="@(_busy || _loading || _editing)" @onclick="ReloadAsync">Retry loading</button>
    }
    @if (_loading)
    {
        <p class="empty-message" role="status">Loading local libraries...</p>
    }
    else if (!VisibleInstances.Any() && _error is null)
    {
        <p class="empty-message">No @SectionTitle.ToLowerInvariant() libraries configured.</p>
    }
    <ul class="library-list" aria-label="@($"{SectionTitle} libraries")">
        @foreach (var instance in VisibleInstances)
        {
            var status = Calibre.GetStatus(instance.Id);
            var availability = _availability.GetValueOrDefault(instance.Id);
            <li @key="instance.Id">
                <BackendInstanceRow Name="@instance.Name" Type="@KindLabel(instance.Kind)" Status="@(instance.IsExternal || availability is null ? "Unknown" : availability == "Available" ? "Available" : "Unavailable")"
                    StatusClass="@(instance.IsExternal || availability is null ? "unknown" : availability == "Available" ? "online" : "offline")"
                    Selected="@Selection.IsSelected(SelectionKey(instance), instance.Id)" OnSelect="() => Selection.Select(SelectionKey(instance), instance.Id)">
                    <Actions>
                    @if (instance.IsManaged)
                    {
                        <span class="backend-process-status" role="status">@(status.IsRunning ? "Running" : "Stopped")</span>
                        <button class="icon-button" type="button" title="Start Calibre" aria-label="@($"Start Calibre {instance.Name}")" disabled="@(_busy || _calibreBusy || _editing || status.IsRunning)" @onclick='() => RunCalibreAsync(instance, "start")'><MudIcon Icon="@Icons.Material.Filled.PlayArrow" /></button>
                        <button class="icon-button" type="button" title="Stop Calibre" aria-label="@($"Stop Calibre {instance.Name}")" disabled="@(_busy || _calibreBusy || _editing || !status.IsRunning)" @onclick='() => RunCalibreAsync(instance, "stop")'><MudIcon Icon="@Icons.Material.Filled.Stop" /></button>
                        <button class="icon-button" type="button" title="Restart Calibre" aria-label="@($"Restart Calibre {instance.Name}")" disabled="@(_busy || _calibreBusy || _editing || !status.IsRunning)" @onclick='() => RunCalibreAsync(instance, "restart")'><MudIcon Icon="@Icons.Material.Filled.Refresh" /></button>
                    }
                    </Actions>
                </BackendInstanceRow>
            </li>
        }
    </ul>

    @if (_editing)
    {
        <div class="library-backdrop" @onkeydown="HandleEditorKey">
            <dialog open class="library-dialog" aria-modal="true" aria-labelledby="@FieldId("editor-title")">
                <span class="focus-guard" tabindex="0" @onfocus="FocusLastAsync"></span>
                <header class="editor-heading">
                    <h3 id="@FieldId("editor-title")">@($"{(_editingId is null ? "Add" : "Edit")} {SectionTitle} library")</h3>
                    <button class="icon-button" type="button" title="Close local library editor" aria-label="Close local library editor" aria-disabled="@_busy" @ref="_closeButton" @onclick="CancelEdit">
                        <MudIcon Icon="@Icons.Material.Filled.Close" aria-hidden="true" />
                    </button>
                </header>
                @if (_editorError is not null)
                {
                    <p class="error-message" role="alert">@_editorError</p>
                }
                <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" aria-busy="@_busy">
                    <fieldset disabled="@_busy">
                        @if (FilterKind is null)
                        {
                        <label for="@FieldId("kind")">Library kind</label>
                        <select id="@FieldId("kind")" @bind="_draftKind">
                            <option value="@LocalLibraryKind.Notes">Notes</option>
                            <option value="@LocalLibraryKind.Calibre">Calibre</option>
                        </select>
                        }
                        <label for="@FieldId("name")">Library name</label>
                        <input id="@FieldId("name")" @ref="_nameInput" @bind="_draftName" @bind:event="oninput" maxlength="60" required autofocus />
                        @if (_draftKind != LocalLibraryKind.Notes)
                        {
                            <div class="mode-selector" role="radiogroup" aria-label="Calibre mode">
                                <label><input type="radio" name="@FieldId("mode")" checked="@(!_draftExternal)" @onchange="() => ChangeMode(false)" /> Managed</label>
                                <label><input type="radio" name="@FieldId("mode")" checked="@_draftExternal" @onchange="() => ChangeMode(true)" /> External</label>
                            </div>
                        }
                        @if (_draftKind == LocalLibraryKind.Notes || !_draftExternal)
                        {
                        <label for="@FieldId("path")">Absolute server folder path</label>
                        <input id="@FieldId("path")" @bind="_draftPath" @bind:event="oninput" placeholder="@PathPlaceholder" required spellcheck="false" autocomplete="off" />
                        }
                        @if (_draftKind == LocalLibraryKind.Notes)
                        {
                            <label class="calibre-checkbox"><input type="checkbox" @bind="_draftAutoGitPull" /> Auto Git pull</label>
                            <label for="@FieldId("hydrus")">Hydrus instance for @@hydrus references</label>
                            <select id="@FieldId("hydrus")" @bind="_draftHydrusId">
                                <option value="">None</option>
                                @foreach (var hydrus in _hydrusInstances)
                                {
                                    <option value="@hydrus.Id">@hydrus.Name</option>
                                }
                            </select>
                            <label for="@FieldId("stash")">Stash instance for @@stash references</label>
                            <select id="@FieldId("stash")" @bind="_draftStashId">
                                <option value="">None</option>
                                @foreach (var stash in _stashInstances)
                                {
                                    <option value="@stash.Id">@stash.Name</option>
                                }
                            </select>
                        }
                        else if (_draftExternal || !string.IsNullOrWhiteSpace(_draftServerUrl))
                        {
                            <label for="@FieldId("server-url")">Content Server URL</label>
                            <input id="@FieldId("server-url")" type="url" @bind="_draftServerUrl" placeholder="http://localhost:8080/" required spellcheck="false" autocomplete="off" />
                            <label for="@FieldId("server-library")">Content Server library ID</label>
                            <input id="@FieldId("server-library")" @bind="_draftServerLibrary" maxlength="200" required spellcheck="false" autocomplete="off" />
                        }
                        @if (_draftKind != LocalLibraryKind.Notes && !_draftExternal)
                        {
                            <label for="@FieldId("additional-paths")">Additional Calibre library folders (optional, one per line)</label>
                            <textarea id="@FieldId("additional-paths")" @bind="_draftAdditionalPaths" rows="3" placeholder="M:\CALIBRE\Comics" spellcheck="false" autocomplete="off"></textarea>
                            <small class="field-hint">Folders listed here are served by the same Calibre server, which lets you switch between them. Add separate libraries instead to run them independently.</small>
                            <label for="@FieldId("port")">Loopback port</label>
                            <input id="@FieldId("port")" type="number" min="1024" max="65535" required @bind="_draftPort" />
                            <label for="@FieldId("installation")">Calibre installation folder (optional)</label>
                            <input id="@FieldId("installation")" @bind="_draftInstallation" placeholder="C:\Program Files\Calibre2" spellcheck="false" autocomplete="off" />
                            <label class="calibre-checkbox"><input type="checkbox" @bind="_draftAutostart" /> Start with Personal Server Manager</label>
                        }
                        <div class="editor-actions">
                            <button class="cancel-button" type="button" @onclick="CancelEdit">Cancel</button>
                            <button class="save-button" type="submit" @ref="_saveButton">@(_busy ? "Saving..." : "Save library")</button>
                        </div>
                    </fieldset>
                </form>
                <span class="focus-guard" tabindex="0" @onfocus="FocusFirstAsync"></span>
            </dialog>
        </div>
    }
</section>

@if (VisibleInstances.FirstOrDefault(instance => Selection.IsSelected(SelectionKey(instance), instance.Id)) is { } selected)
{
    var status = Calibre.GetStatus(selected.Id);
    var reader = Calibre.WithReaderConnection(selected);
    <section class="backend-details local-library-details" aria-label="@($"{selected.Name} details")">
        <h2>@selected.Name</h2>
        <dl>
            <dt>Type</dt><dd>@KindLabel(selected.Kind) @(selected.IsManaged ? "(Managed)" : selected.IsExternal ? "(External)" : "")</dd>
            <dt>Availability</dt><dd role="status">@(selected.IsExternal ? "Unknown" : _availability.GetValueOrDefault(selected.Id) ?? "Unknown")</dd>
            @if (selected.IsManaged) { <dt>Process</dt><dd role="status">@status.Message</dd><dt>Port</dt><dd>@selected.ManagedPort</dd> }
            <dt>@(selected.IsExternal ? "Server URL" : "Folders")</dt><dd>@(selected.IsExternal ? selected.ContentServerUrl?.AbsoluteUri : string.Join(" · ", selected.RootPaths))</dd>
            @if (selected.ContentServerUrl is not null && !selected.IsExternal) { <dt>Server URL</dt><dd>@selected.ContentServerUrl.AbsoluteUri</dd> }
            @if (selected.ContentServerLibraryId is not null) { <dt>Library ID</dt><dd>@selected.ContentServerLibraryId</dd> }
            @if (selected.IsManaged && selected.CalibreInstallationFolder is not null) { <dt>Installation</dt><dd>@selected.CalibreInstallationFolder</dd> }
            @if (selected.Kind == LocalLibraryKind.Notes && selected.HydrusInstanceId is not null) { <dt>Hydrus reference</dt><dd>@selected.HydrusInstanceId</dd> }
            @if (selected.Kind == LocalLibraryKind.Notes && selected.StashInstanceId is not null) { <dt>Stash reference</dt><dd>@selected.StashInstanceId</dd> }
        </dl>
        @if (selected.IsManaged)
        {
            <label class="calibre-checkbox"><input type="checkbox" checked="@selected.StartWithApp" disabled="@(_busy || _calibreBusy || _editing)" @onchange="args => SaveAutostartAsync(selected, args.Value is true)" /> Start with Personal Server Manager</label>
        }
        @if (selected.Kind == LocalLibraryKind.Notes)
        {
            <NotesGitControls @key="selected.Id" InstanceId="@selected.Id" Enabled="@selected.AutoGitPull" />
        }
        <div class="detail-actions">
            @if (reader.ContentServerUrl is not null)
            {
                <a class="icon-button" href="@(selected.IsManaged ? reader.ContentServerUrl.PathAndQuery : reader.ContentServerUrl.ToString())" target="_blank" rel="noopener noreferrer" title="Open Calibre Content Server" aria-label="@($"Open Calibre Content Server for {selected.Name}")"><MudIcon Icon="@Icons.Material.Filled.OpenInNew" /></a>
            }
            <button class="icon-button" type="button" title="Edit local library" aria-label="@($"Edit local library {selected.Name}")" disabled="@(_busy || _calibreBusy || _loading || _editing)" @onclick="() => EditLibrary(selected)"><MudIcon Icon="@Icons.Material.Filled.Edit" aria-hidden="true" /></button>
            <button class="icon-button remove-button" type="button" title="Remove local library" aria-label="@($"Remove local library {selected.Name}")" disabled="@(_busy || _calibreBusy || _loading || _editing)" @onclick="() => RemoveAsync(selected)"><MudIcon Icon="@Icons.Material.Filled.DeleteOutline" aria-hidden="true" /></button>
        </div>
    </section>
}

@code {
    [CascadingParameter] public BackendSelection Selection { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public LocalLibraryKind? FilterKind { get; set; }
    private string SectionTitle => FilterKind == LocalLibraryKind.Notes ? "Notes" : FilterKind is null ? "Local libraries" : "Calibre";
    private IEnumerable<LocalLibraryInstance> VisibleInstances => _instances.Where(instance => FilterKind is null ||
        (FilterKind == LocalLibraryKind.Notes ? instance.Kind == LocalLibraryKind.Notes : instance.IsCalibre));

    private readonly CancellationTokenSource _lifetime = new();
    private readonly string _id = $"local-library-{Guid.NewGuid():N}";
    private readonly Dictionary<Guid, string> _availability = [];
    private CancellationToken _token;
    private IReadOnlyList<LocalLibraryInstance> _instances = [];
    private ElementReference _heading;
    private ElementReference _nameInput;
    private ElementReference _closeButton;
    private ElementReference _saveButton;
    private bool _loading = true;
    private bool _busy;
    private bool _editing;
    private bool _disposed;
    private bool _focusEditor;
    private bool _restoreFocus;
    private Guid? _editingId;
    private LocalLibraryKind _draftKind;
    private string _draftName = string.Empty;
    private string _draftPath = string.Empty;
    private string? _draftServerUrl;
    private string? _draftServerLibrary;
    private string? _error;
    private string? _editorError;
    private bool _draftExternal;
    private int _draftPort = 8080;
    private bool _draftAutostart;
    private bool _draftAutoGitPull;
    private Guid? _draftHydrusId;
    private Guid? _draftStashId;
    private IReadOnlyList<PersonalServerManager.Hydrus.HydrusInstance> _hydrusInstances = [];
    private IReadOnlyList<PersonalServerManager.Stash.StashInstance> _stashInstances = [];
    private string? _draftInstallation;
    private string? _draftAdditionalPaths;
    private bool _calibreBusy;

    private string FieldId(string suffix) => $"{_id}-{suffix}";
    private static string SelectionKey(LocalLibraryInstance instance) => instance.Kind == LocalLibraryKind.Notes ? "Notes" : "Calibre";
    private void SelectionChanged() => _ = InvokeAsync(StateHasChanged);

    private string PathPlaceholder => _draftKind switch
    {
        LocalLibraryKind.Calibre => @"M:\CALIBRE\Books",
        _ => @"C:\ProgrammingProjects\StoryWriting"
    };

    private static string KindLabel(LocalLibraryKind kind) => kind switch
    {
        LocalLibraryKind.Notes => "Notes",
        LocalLibraryKind.Calibre or LocalLibraryKind.CalibreText or LocalLibraryKind.CalibreComic => "Calibre",
        _ => "Unknown kind"
    };

    protected override async Task OnInitializedAsync()
    {
        _token = _lifetime.Token;
        Selection.Changed += SelectionChanged;
        await ReloadAsync();
    }

    private async Task RunCalibreAsync(LocalLibraryInstance instance, string operation)
    {
        if (_calibreBusy || _busy || _editing) return;
        _calibreBusy = true;
        _error = null;
        try
        {
            if (operation == "stop") await Calibre.StopServerAsync(instance.Id);
            if (operation == "restart") await Calibre.RestartServerAsync(instance.Id, _token);
            if (operation == "start") await Calibre.StartServerAsync(instance.Id, _token);
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception) || exception is System.ComponentModel.Win32Exception or OperationCanceledException)
        {
            _error = exception is InvalidDataException ? exception.Message : "The Calibre server could not be updated.";
        }
        finally
        {
            RefreshAvailability();
            _calibreBusy = false;
        }
    }

    private async Task SaveAutostartAsync(LocalLibraryInstance instance, bool enabled)
    {
        if (_busy || _calibreBusy || _editing) return;
        _busy = true;
        try
        {
            await Store.UpdateAsync(instance with { StartWithApp = enabled }, _token);
            await ReloadAsync();
            await NotifyChangedAsync();
        }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = exception is InvalidDataException && exception.Message == "The local library no longer exists."
                ? exception.Message : "Could not save the autostart setting.";
        }
        finally { _busy = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ = RefreshPeriodicallyAsync();
        if (_disposed || (!_focusEditor && !_restoreFocus))
        {
            return;
        }

        var target = _focusEditor && _editing ? _nameInput : _heading;
        _focusEditor = false;
        _restoreFocus = false;
        try
        {
            await target.FocusAsync();
        }
        catch (JSException) { }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
    }

    private async Task RefreshPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_token))
                await InvokeAsync(() =>
                {
                    if (_disposed) return;
                    RefreshAvailability();
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (_disposed) { }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var instances = await Store.GetAllAsync(_token);
            if (!_disposed)
            {
                _instances = instances;
                RefreshAvailability();
            }
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "Could not load local libraries. Check configuration file access, then retry. Previously loaded libraries are unchanged.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void RefreshAvailability()
    {
        _availability.Clear();
        foreach (var instance in _instances)
        {
            _availability[instance.Id] = instance.IsExternal ? "External" :
                instance.RootPaths.Select(path => ValidateRoot(path, instance.Kind)).FirstOrDefault(error => error is not null) ?? "Available";
        }
    }

    private static string? ValidateRoot(string path, LocalLibraryKind kind)
    {
        if (!Enum.IsDefined(kind))
        {
            return "Select a supported library kind.";
        }

        try
        {
            if (string.IsNullOrWhiteSpace(path) || !Path.IsPathFullyQualified(path))
            {
                return "Enter an absolute server folder path.";
            }

            if (!Directory.Exists(path))
            {
                return "Unavailable: folder does not exist or cannot be accessed.";
            }

            if ((File.GetAttributes(path) & FileAttributes.ReparsePoint) != 0)
            {
                return "Unavailable: the root folder cannot be a symbolic link or junction.";
            }

            if (kind != LocalLibraryKind.Notes && !File.Exists(Path.Combine(path, "metadata.db")))
            {
                return "Unavailable: this Calibre folder must contain metadata.db.";
            }

            return null;
        }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            return "Unavailable: check the server folder path and access permissions.";
        }
    }

    private void AddLibrary()
    {
        _editingId = null;
        _draftKind = FilterKind == LocalLibraryKind.Notes || FilterKind is null ? LocalLibraryKind.Notes : LocalLibraryKind.Calibre;
        _draftName = string.Empty;
        _draftPath = string.Empty;
        _draftServerUrl = _draftServerLibrary = null;
        _draftExternal = _draftAutostart = _draftAutoGitPull = false;
        _draftHydrusId = _draftStashId = null;
        _draftPort = 8080;
        _draftInstallation = null;
        _draftAdditionalPaths = null;
        OpenEditor();
    }

    private void ChangeMode(bool external)
    {
        _draftExternal = external;
        if (!external) _draftServerUrl = _draftServerLibrary = null;
    }

    private void EditLibrary(LocalLibraryInstance instance)
    {
        if (Calibre.GetStatus(instance.Id).IsRunning)
        {
            _error = "Stop Calibre before editing its configuration.";
            return;
        }
        _editingId = instance.Id;
        _draftKind = instance.IsCalibre ? LocalLibraryKind.Calibre : LocalLibraryKind.Notes;
        _draftName = instance.Name;
        _draftPath = instance.RootPath;
        _draftServerUrl = instance.ContentServerUrl?.AbsoluteUri;
        _draftServerLibrary = instance.ContentServerLibraryId;
        _draftExternal = instance.IsExternal;
        _draftPort = instance.ManagedPort;
        _draftAutostart = instance.StartWithApp;
        _draftInstallation = instance.CalibreInstallationFolder;
        _draftAdditionalPaths = instance.AdditionalRootPaths is { Count: > 0 } additional ? string.Join(Environment.NewLine, additional) : null;
        _draftAutoGitPull = instance.AutoGitPull;
        _draftHydrusId = instance.HydrusInstanceId;
        _draftStashId = instance.StashInstanceId;
        OpenEditor();
    }

    private void OpenEditor()
    {
        _editorError = null;
        _editing = true;
        _focusEditor = true;
        _ = RefreshLinkTargetsAsync();
    }

    private async Task LoadLinkTargetsAsync()
    {
        if (FilterKind == LocalLibraryKind.Calibre) return;
        _hydrusInstances = await HydrusStore.GetAllAsync(_token);
        _stashInstances = await StashStore.GetAllAsync(_token);
    }

    private async Task RefreshLinkTargetsAsync()
    {
        try
        {
            await LoadLinkTargetsAsync();
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _editorError = "Could not load Hydrus and Stash instances to link.";
        }
    }

    private void CancelEdit()
    {
        if (!_busy)
        {
            CloseEditor();
        }
    }

    private void CloseEditor()
    {
        _editing = false;
        _editingId = null;
        _draftName = string.Empty;
        _draftPath = string.Empty;
        _editorError = null;
        _restoreFocus = true;
    }

    private void HandleEditorKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private Task FocusFirstAsync() => _closeButton.FocusAsync().AsTask();
    private Task FocusLastAsync() => (_busy ? _closeButton : _saveButton).FocusAsync().AsTask();

    private async Task SaveAsync()
    {
        if (_busy || _calibreBusy || _disposed)
        {
            return;
        }

        _editorError = null;
        if (string.IsNullOrWhiteSpace(_draftName) || _draftName.Trim().Length > 60)
        {
            _editorError = "Enter a library name of up to 60 characters.";
            return;
        }

        var external = _draftKind != LocalLibraryKind.Notes && _draftExternal;
        var path = external ? "" : _draftPath.Trim();
        _editorError = external ? null : ValidateRoot(path, _draftKind);
        if (_editorError is not null)
        {
            return;
        }

        string[]? additionalPaths = null;
        if (_draftKind != LocalLibraryKind.Notes && !external && !string.IsNullOrWhiteSpace(_draftAdditionalPaths))
        {
            additionalPaths = _draftAdditionalPaths.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (additionalPaths.Length > LocalLibraryInstance.MaximumAdditionalRootPaths)
            {
                _editorError = $"Enter at most {LocalLibraryInstance.MaximumAdditionalRootPaths} additional folders.";
                return;
            }
            foreach (var additional in additionalPaths)
            {
                if (ValidateRoot(additional, _draftKind) is { } error)
                {
                    _editorError = $"{additional}: {error}";
                    return;
                }
            }
            additionalPaths = additionalPaths.Select(Path.GetFullPath).ToArray();
            var all = additionalPaths.Prepend(Path.GetFullPath(path)).Select(Path.TrimEndingDirectorySeparator).ToArray();
            if (all.Select(Path.GetFileName).Distinct(StringComparer.OrdinalIgnoreCase).Count() != all.Length)
            {
                _editorError = "Each Calibre folder in one library must have a distinct folder name.";
                return;
            }
        }

        Uri? serverUrl = null;
        string? serverLibrary = null;
        if (_draftKind != LocalLibraryKind.Notes)
        {
            if (!string.IsNullOrWhiteSpace(_draftServerUrl) && !Uri.TryCreate(_draftServerUrl.Trim(), UriKind.Absolute, out serverUrl))
            {
                _editorError = "Enter a valid HTTP or HTTPS Content Server URL.";
                return;
            }
            serverLibrary = string.IsNullOrWhiteSpace(_draftServerLibrary) ? null : _draftServerLibrary.Trim();
        }
        var existing = _instances.FirstOrDefault(instance => instance.Id == _editingId);
        var kind = existing?.IsCalibre == true && _draftKind != LocalLibraryKind.Notes ? existing.Kind : _draftKind;
        var instance = new LocalLibraryInstance(_editingId ?? Guid.NewGuid(), _draftName.Trim(), external ? "" : Path.GetFullPath(path), kind, serverUrl, serverLibrary,
            _draftPort, _draftAutostart, string.IsNullOrWhiteSpace(_draftInstallation) ? null : _draftInstallation.Trim(),
            _draftKind == LocalLibraryKind.Notes && _draftAutoGitPull,
            _draftKind == LocalLibraryKind.Notes ? _draftHydrusId : null,
            _draftKind == LocalLibraryKind.Notes ? _draftStashId : null,
            additionalPaths is { Length: > 0 } ? additionalPaths : null);
        if (!instance.HasValidReaderConfiguration())
        {
            _editorError = "Enter both a Content Server library ID and an HTTP or HTTPS URL without credentials, a query, or a fragment.";
            return;
        }

        _busy = true;
        try
        {
            if (_editingId is null) await Store.SaveAsync(instance, _token);
            else if (existing?.IsCalibre == true || instance.IsCalibre) await Calibre.UpdateLibraryAsync(instance, _token);
            else await Store.UpdateAsync(instance, _token);
            if (_disposed)
            {
                return;
            }

            _instances = _instances.Where(existing => existing.Id != instance.Id).Append(instance).ToArray();
            RefreshAvailability();
            CloseEditor();
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _editorError = exception is InvalidDataException && (exception.Message == "The local library no longer exists."
                || exception.Message == "Stop Calibre before editing its configuration.")
                ? exception.Message : "Could not save this library. Check configuration file access and the server folder, then retry. Your entries are unchanged.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(LocalLibraryInstance instance)
    {
        if (_busy || _calibreBusy || _editing || _disposed)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var consequence = instance.IsManaged ? "Its managed Calibre process will be stopped." : instance.IsExternal ? "The external service will remain running." : "The Notes folder and its files will be kept. An active Git sync must finish first.";
            if (!await JavaScript.InvokeAsync<bool>("confirm", _token, $"Remove local library '{instance.Name}'? {consequence} Only its configuration will be removed; local files will be kept."))
            {
                return;
            }

            if (instance.Kind == LocalLibraryKind.Notes) await GitSync.RemoveAsync(instance.Id, _token);
            else await Calibre.RemoveLibraryAsync(instance.Id, _token);
            Selection.Clear(SelectionKey(instance), instance.Id);
            if (_disposed)
            {
                return;
            }

            _instances = _instances.Where(existing => existing.Id != instance.Id).ToArray();
            RefreshAvailability();
            _restoreFocus = true;
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (InvalidDataException exception) { _error = exception.Message; }
        catch (Exception exception) when (IsExpectedFailure(exception) || exception is JSException)
        {
            _error = "Could not remove this library. Check the browser connection and configuration file access, then retry. The list is unchanged.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NotifyChangedAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "Library configuration was saved, but the library could not refresh. Reload the page to retry.";
        }
    }

    private static bool IsExpectedFailure(Exception exception) => exception is
        IOException or InvalidDataException or UnauthorizedAccessException or System.Security.SecurityException or
        JsonException or ArgumentException or InvalidOperationException or NotSupportedException or OperationCanceledException;

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        Selection.Changed -= SelectionChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}