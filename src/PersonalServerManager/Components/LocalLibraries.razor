@using PersonalServerManager.LocalLibraries
@using System.Text.Json
@implements IDisposable
@inject ILocalLibraryStore Store
@inject IJSRuntime JavaScript

<section class="local-libraries" aria-labelledby="@FieldId("heading")">
    <header class="library-heading">
        <h2 id="@FieldId("heading")" tabindex="-1" @ref="_heading">Local libraries</h2>
        <button class="icon-button" type="button" title="Add local library" aria-label="Add local library" disabled="@(_busy || _loading || _editing)" @onclick="AddLibrary">
            <MudIcon Icon="@Icons.Material.Filled.Add" aria-hidden="true" />
        </button>
    </header>
    @if (_error is not null)
    {
        <p class="error-message" role="alert">@_error</p>
        <button class="retry-button" type="button" disabled="@(_busy || _loading || _editing)" @onclick="ReloadAsync">Retry loading</button>
    }
    @if (_loading)
    {
        <p class="empty-message" role="status">Loading local libraries...</p>
    }
    else if (_instances.Count == 0 && _error is null)
    {
        <p class="empty-message">No local libraries configured.</p>
    }
    <ul class="library-list" aria-label="Local libraries">
        @foreach (var instance in _instances)
        {
            var available = _availability.GetValueOrDefault(instance.Id) == "Available";
            <li @key="instance.Id" class="library-row">
                <span class="status-dot @(available ? "online" : "offline")" aria-hidden="true"></span>
                <div class="instance-copy">
                    <strong>@instance.Name</strong>
                    <span class="instance-kind">@KindLabel(instance.Kind)</span>
                    <span class="instance-status" role="status">@_availability.GetValueOrDefault(instance.Id, "Unavailable")</span>
                    <small class="root-path">@instance.RootPath</small>
                </div>
                <div class="row-actions">
                    <button class="icon-button" type="button" title="Edit local library" aria-label="@($"Edit local library {instance.Name}")" disabled="@(_busy || _loading || _editing)" @onclick="() => EditLibrary(instance)">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" aria-hidden="true" />
                    </button>
                    <button class="icon-button remove-button" type="button" title="Remove local library" aria-label="@($"Remove local library {instance.Name}")" disabled="@(_busy || _loading || _editing)" @onclick="() => RemoveAsync(instance)">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" aria-hidden="true" />
                    </button>
                </div>
            </li>
        }
    </ul>

    @if (_editing)
    {
        <div class="library-backdrop" @onkeydown="HandleEditorKey">
            <dialog open class="library-dialog" aria-modal="true" aria-labelledby="@FieldId("editor-title")">
                <span class="focus-guard" tabindex="0" @onfocus="FocusLastAsync"></span>
                <header class="editor-heading">
                    <h3 id="@FieldId("editor-title")">@(_editingId is null ? "Add local library" : "Edit local library")</h3>
                    <button class="icon-button" type="button" title="Close local library editor" aria-label="Close local library editor" aria-disabled="@_busy" @ref="_closeButton" @onclick="CancelEdit">
                        <MudIcon Icon="@Icons.Material.Filled.Close" aria-hidden="true" />
                    </button>
                </header>
                @if (_editorError is not null)
                {
                    <p class="error-message" role="alert">@_editorError</p>
                }
                <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" aria-busy="@_busy">
                    <fieldset disabled="@_busy">
                        <label for="@FieldId("kind")">Library kind</label>
                        <select id="@FieldId("kind")" @bind="_draftKind">
                            <option value="@LocalLibraryKind.Notes">Notes</option>
                            <option value="@LocalLibraryKind.CalibreText">Calibre ebooks</option>
                            <option value="@LocalLibraryKind.CalibreComic">Calibre comics</option>
                        </select>
                        <label for="@FieldId("name")">Library name</label>
                        <input id="@FieldId("name")" @ref="_nameInput" @bind="_draftName" @bind:event="oninput" maxlength="60" required autofocus />
                        <label for="@FieldId("path")">Absolute server folder path</label>
                        <input id="@FieldId("path")" @bind="_draftPath" @bind:event="oninput" placeholder="@PathPlaceholder" required spellcheck="false" autocomplete="off" />
                        <div class="editor-actions">
                            <button class="cancel-button" type="button" @onclick="CancelEdit">Cancel</button>
                            <button class="save-button" type="submit" @ref="_saveButton">@(_busy ? "Saving..." : "Save library")</button>
                        </div>
                    </fieldset>
                </form>
                <span class="focus-guard" tabindex="0" @onfocus="FocusFirstAsync"></span>
            </dialog>
        </div>
    }
</section>

@code {
    [Parameter] public EventCallback Changed { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly string _id = $"local-library-{Guid.NewGuid():N}";
    private readonly Dictionary<Guid, string> _availability = [];
    private CancellationToken _token;
    private IReadOnlyList<LocalLibraryInstance> _instances = [];
    private ElementReference _heading;
    private ElementReference _nameInput;
    private ElementReference _closeButton;
    private ElementReference _saveButton;
    private bool _loading = true;
    private bool _busy;
    private bool _editing;
    private bool _disposed;
    private bool _focusEditor;
    private bool _restoreFocus;
    private Guid? _editingId;
    private LocalLibraryKind _draftKind;
    private string _draftName = string.Empty;
    private string _draftPath = string.Empty;
    private string? _error;
    private string? _editorError;

    private string FieldId(string suffix) => $"{_id}-{suffix}";

    private string PathPlaceholder => _draftKind switch
    {
        LocalLibraryKind.CalibreText => @"M:\CALIBRE\Calibre Text",
        LocalLibraryKind.CalibreComic => @"M:\CALIBRE\SFW Comics",
        _ => @"C:\ProgrammingProjects\StoryWriting"
    };

    private static string KindLabel(LocalLibraryKind kind) => kind switch
    {
        LocalLibraryKind.Notes => "Notes",
        LocalLibraryKind.CalibreText => "Calibre ebooks",
        LocalLibraryKind.CalibreComic => "Calibre comics",
        _ => "Unknown kind"
    };

    protected override async Task OnInitializedAsync()
    {
        _token = _lifetime.Token;
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || (!_focusEditor && !_restoreFocus))
        {
            return;
        }

        var target = _focusEditor && _editing ? _nameInput : _heading;
        _focusEditor = false;
        _restoreFocus = false;
        try
        {
            await target.FocusAsync();
        }
        catch (JSException) { }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var instances = await Store.GetAllAsync(_token);
            if (!_disposed)
            {
                _instances = instances;
                RefreshAvailability();
            }
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "Could not load local libraries. Check configuration file access, then retry. Previously loaded libraries are unchanged.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void RefreshAvailability()
    {
        _availability.Clear();
        foreach (var instance in _instances)
        {
            _availability[instance.Id] = ValidateRoot(instance.RootPath, instance.Kind) ?? "Available";
        }
    }

    private static string? ValidateRoot(string path, LocalLibraryKind kind)
    {
        if (!Enum.IsDefined(kind))
        {
            return "Select a supported library kind.";
        }

        try
        {
            if (string.IsNullOrWhiteSpace(path) || !Path.IsPathFullyQualified(path))
            {
                return "Enter an absolute server folder path.";
            }

            if (!Directory.Exists(path))
            {
                return "Unavailable: folder does not exist or cannot be accessed.";
            }

            if ((File.GetAttributes(path) & FileAttributes.ReparsePoint) != 0)
            {
                return "Unavailable: the root folder cannot be a symbolic link or junction.";
            }

            if (kind != LocalLibraryKind.Notes && !File.Exists(Path.Combine(path, "metadata.db")))
            {
                return "Unavailable: this Calibre folder must contain metadata.db.";
            }

            return null;
        }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            return "Unavailable: check the server folder path and access permissions.";
        }
    }

    private void AddLibrary()
    {
        _editingId = null;
        _draftKind = LocalLibraryKind.Notes;
        _draftName = string.Empty;
        _draftPath = string.Empty;
        OpenEditor();
    }

    private void EditLibrary(LocalLibraryInstance instance)
    {
        _editingId = instance.Id;
        _draftKind = instance.Kind;
        _draftName = instance.Name;
        _draftPath = instance.RootPath;
        OpenEditor();
    }

    private void OpenEditor()
    {
        _editorError = null;
        _editing = true;
        _focusEditor = true;
    }

    private void CancelEdit()
    {
        if (!_busy)
        {
            CloseEditor();
        }
    }

    private void CloseEditor()
    {
        _editing = false;
        _editingId = null;
        _draftName = string.Empty;
        _draftPath = string.Empty;
        _editorError = null;
        _restoreFocus = true;
    }

    private void HandleEditorKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private Task FocusFirstAsync() => _closeButton.FocusAsync().AsTask();
    private Task FocusLastAsync() => (_busy ? _closeButton : _saveButton).FocusAsync().AsTask();

    private async Task SaveAsync()
    {
        if (_busy || _disposed)
        {
            return;
        }

        _editorError = null;
        if (string.IsNullOrWhiteSpace(_draftName) || _draftName.Trim().Length > 60)
        {
            _editorError = "Enter a library name of up to 60 characters.";
            return;
        }

        var path = _draftPath.Trim();
        _editorError = ValidateRoot(path, _draftKind);
        if (_editorError is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            var instance = new LocalLibraryInstance(_editingId ?? Guid.NewGuid(), _draftName.Trim(), Path.GetFullPath(path), _draftKind);
            await Store.SaveAsync(instance, _token);
            if (_disposed)
            {
                return;
            }

            _instances = _instances.Where(existing => existing.Id != instance.Id).Append(instance).ToArray();
            RefreshAvailability();
            CloseEditor();
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _editorError = "Could not save this library. Check configuration file access and the server folder, then retry. Your entries are unchanged.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(LocalLibraryInstance instance)
    {
        if (_busy || _disposed)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (!await JavaScript.InvokeAsync<bool>("confirm", _token, $"Remove local library '{instance.Name}'? Only its configuration will be removed. The folder and its files will not be changed."))
            {
                return;
            }

            await Store.RemoveAsync(instance.Id, _token);
            if (_disposed)
            {
                return;
            }

            _instances = _instances.Where(existing => existing.Id != instance.Id).ToArray();
            RefreshAvailability();
            _restoreFocus = true;
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception) || exception is JSException)
        {
            _error = "Could not remove this library. Check the browser connection and configuration file access, then retry. The list is unchanged.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NotifyChangedAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "Library configuration was saved, but the library could not refresh. Reload the page to retry.";
        }
    }

    private static bool IsExpectedFailure(Exception exception) => exception is
        IOException or UnauthorizedAccessException or System.Security.SecurityException or
        JsonException or ArgumentException or InvalidOperationException or NotSupportedException or OperationCanceledException;

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}