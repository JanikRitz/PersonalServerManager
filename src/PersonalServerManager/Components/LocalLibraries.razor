@using PersonalServerManager.LocalLibraries
@using System.Text.Json
@implements IDisposable
@inject ILocalLibraryStore Store
@inject ManagedCalibreServer Calibre
@inject IJSRuntime JavaScript

<section class="local-libraries" aria-labelledby="@FieldId("heading")">
    <header class="library-heading">
        <h2 id="@FieldId("heading")" tabindex="-1" @ref="_heading">@SectionTitle</h2>
        <button class="icon-button" type="button" title="@($"Add {SectionTitle} library")" aria-label="@($"Add {SectionTitle} library")" disabled="@(_busy || _loading || _editing)" @onclick="AddLibrary">
            <MudIcon Icon="@Icons.Material.Filled.Add" aria-hidden="true" />
        </button>
    </header>
    @if (_error is not null)
    {
        <p class="error-message" role="alert">@_error</p>
        <button class="retry-button" type="button" disabled="@(_busy || _loading || _editing)" @onclick="ReloadAsync">Retry loading</button>
    }
    @if (_loading)
    {
        <p class="empty-message" role="status">Loading local libraries...</p>
    }
    else if (!VisibleInstances.Any() && _error is null)
    {
        <p class="empty-message">No @SectionTitle.ToLowerInvariant() libraries configured.</p>
    }
    <ul class="library-list" aria-label="@($"{SectionTitle} libraries")">
        @foreach (var instance in VisibleInstances)
        {
            var available = _availability.GetValueOrDefault(instance.Id) == "Available";
            var status = Calibre.GetStatus(instance.Id);
            var readerInstance = Calibre.WithReaderConnection(instance);
            <li @key="instance.Id" class="library-row">
                <span class="status-dot @(available ? "online" : "offline")" aria-hidden="true"></span>
                <div class="instance-copy">
                    <strong>@instance.Name</strong>
                    <span class="instance-kind">@KindLabel(instance.Kind)</span>
                    <span class="instance-status" role="status">@_availability.GetValueOrDefault(instance.Id, "Unavailable")</span>
                    <small class="root-path">@(instance.IsExternal ? instance.ContentServerUrl?.AbsoluteUri : instance.RootPath)</small>
                    @if (instance.IsManaged)
                    {
                        <span class="managed-badge" role="status">Managed · @status.Message · Port @instance.ManagedPort</span>
                        <label class="calibre-checkbox"><input type="checkbox" checked="@instance.StartWithApp" disabled="@(_busy || _calibreBusy)" @onchange="args => SaveAutostartAsync(instance, args.Value is true)" /> Start with Personal Server Manager</label>
                    }
                    @if (instance.Kind == LocalLibraryKind.Notes)
                    {
                        <NotesGitControls InstanceId="@instance.Id" Enabled="@instance.AutoGitPull" />
                    }
                </div>
                <div class="row-actions">
                    @if (instance.IsManaged)
                    {
                        <button class="icon-button" type="button" title="Start Calibre" aria-label="@($"Start Calibre {instance.Name}")" disabled="@(_busy || _calibreBusy || status.IsRunning)" @onclick="() => ToggleCalibreAsync(instance)"><MudIcon Icon="@Icons.Material.Filled.PlayArrow" /></button>
                        <button class="icon-button" type="button" title="Stop Calibre" aria-label="@($"Stop Calibre {instance.Name}")" disabled="@(_busy || _calibreBusy || !status.IsRunning)" @onclick="() => ToggleCalibreAsync(instance)"><MudIcon Icon="@Icons.Material.Filled.Stop" /></button>
                        <button class="icon-button" type="button" title="Refresh Calibre status" aria-label="@($"Refresh Calibre {instance.Name}")" @onclick="RefreshAvailability"><MudIcon Icon="@Icons.Material.Filled.Refresh" /></button>
                    }
                    @if (readerInstance.ContentServerUrl is not null)
                    {
                        <a class="icon-button" href="@(instance.IsManaged ? readerInstance.ContentServerUrl.PathAndQuery : readerInstance.ContentServerUrl.ToString())" target="_blank" rel="noopener noreferrer" title="Open Calibre Content Server" aria-label="@($"Open Calibre Content Server for {instance.Name}")"><MudIcon Icon="@Icons.Material.Filled.OpenInNew" /></a>
                    }
                    <button class="icon-button" type="button" title="Edit local library" aria-label="@($"Edit local library {instance.Name}")" disabled="@(_busy || _loading || _editing)" @onclick="() => EditLibrary(instance)">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" aria-hidden="true" />
                    </button>
                    <button class="icon-button remove-button" type="button" title="Remove local library" aria-label="@($"Remove local library {instance.Name}")" disabled="@(_busy || _loading || _editing)" @onclick="() => RemoveAsync(instance)">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" aria-hidden="true" />
                    </button>
                </div>
            </li>
        }
    </ul>

    @if (_editing)
    {
        <div class="library-backdrop" @onkeydown="HandleEditorKey">
            <dialog open class="library-dialog" aria-modal="true" aria-labelledby="@FieldId("editor-title")">
                <span class="focus-guard" tabindex="0" @onfocus="FocusLastAsync"></span>
                <header class="editor-heading">
                    <h3 id="@FieldId("editor-title")">@($"{(_editingId is null ? "Add" : "Edit")} {SectionTitle} library")</h3>
                    <button class="icon-button" type="button" title="Close local library editor" aria-label="Close local library editor" aria-disabled="@_busy" @ref="_closeButton" @onclick="CancelEdit">
                        <MudIcon Icon="@Icons.Material.Filled.Close" aria-hidden="true" />
                    </button>
                </header>
                @if (_editorError is not null)
                {
                    <p class="error-message" role="alert">@_editorError</p>
                }
                <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" aria-busy="@_busy">
                    <fieldset disabled="@_busy">
                        @if (FilterKind is null)
                        {
                        <label for="@FieldId("kind")">Library kind</label>
                        <select id="@FieldId("kind")" @bind="_draftKind">
                            <option value="@LocalLibraryKind.Notes">Notes</option>
                            <option value="@LocalLibraryKind.Calibre">Calibre</option>
                        </select>
                        }
                        <label for="@FieldId("name")">Library name</label>
                        <input id="@FieldId("name")" @ref="_nameInput" @bind="_draftName" @bind:event="oninput" maxlength="60" required autofocus />
                        @if (_draftKind != LocalLibraryKind.Notes)
                        {
                            <div class="mode-selector" role="radiogroup" aria-label="Calibre mode">
                                <label><input type="radio" name="@FieldId("mode")" checked="@(!_draftExternal)" @onchange="() => ChangeMode(false)" /> Managed</label>
                                <label><input type="radio" name="@FieldId("mode")" checked="@_draftExternal" @onchange="() => ChangeMode(true)" /> External</label>
                            </div>
                        }
                        @if (_draftKind == LocalLibraryKind.Notes || !_draftExternal)
                        {
                        <label for="@FieldId("path")">Absolute server folder path</label>
                        <input id="@FieldId("path")" @bind="_draftPath" @bind:event="oninput" placeholder="@PathPlaceholder" required spellcheck="false" autocomplete="off" />
                        }
                        @if (_draftKind == LocalLibraryKind.Notes)
                        {
                            <label class="calibre-checkbox"><input type="checkbox" @bind="_draftAutoGitPull" /> Auto Git pull</label>
                        }
                        else if (_draftExternal || !string.IsNullOrWhiteSpace(_draftServerUrl))
                        {
                            <label for="@FieldId("server-url")">Content Server URL</label>
                            <input id="@FieldId("server-url")" type="url" @bind="_draftServerUrl" placeholder="http://localhost:8080/" required spellcheck="false" autocomplete="off" />
                            <label for="@FieldId("server-library")">Content Server library ID</label>
                            <input id="@FieldId("server-library")" @bind="_draftServerLibrary" maxlength="200" required spellcheck="false" autocomplete="off" />
                        }
                        @if (_draftKind != LocalLibraryKind.Notes && !_draftExternal)
                        {
                            <label for="@FieldId("port")">Loopback port</label>
                            <input id="@FieldId("port")" type="number" min="1024" max="65535" required @bind="_draftPort" />
                            <label for="@FieldId("installation")">Calibre installation folder (optional)</label>
                            <input id="@FieldId("installation")" @bind="_draftInstallation" placeholder="C:\Program Files\Calibre2" spellcheck="false" autocomplete="off" />
                            <label class="calibre-checkbox"><input type="checkbox" @bind="_draftAutostart" /> Start with Personal Server Manager</label>
                        }
                        <div class="editor-actions">
                            <button class="cancel-button" type="button" @onclick="CancelEdit">Cancel</button>
                            <button class="save-button" type="submit" @ref="_saveButton">@(_busy ? "Saving..." : "Save library")</button>
                        </div>
                    </fieldset>
                </form>
                <span class="focus-guard" tabindex="0" @onfocus="FocusFirstAsync"></span>
            </dialog>
        </div>
    }
</section>

@code {
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public LocalLibraryKind? FilterKind { get; set; }
    private string SectionTitle => FilterKind == LocalLibraryKind.Notes ? "Notes" : FilterKind is null ? "Local libraries" : "Calibre";
    private IEnumerable<LocalLibraryInstance> VisibleInstances => _instances.Where(instance => FilterKind is null ||
        (FilterKind == LocalLibraryKind.Notes ? instance.Kind == LocalLibraryKind.Notes : instance.IsCalibre));

    private readonly CancellationTokenSource _lifetime = new();
    private readonly string _id = $"local-library-{Guid.NewGuid():N}";
    private readonly Dictionary<Guid, string> _availability = [];
    private CancellationToken _token;
    private IReadOnlyList<LocalLibraryInstance> _instances = [];
    private ElementReference _heading;
    private ElementReference _nameInput;
    private ElementReference _closeButton;
    private ElementReference _saveButton;
    private bool _loading = true;
    private bool _busy;
    private bool _editing;
    private bool _disposed;
    private bool _focusEditor;
    private bool _restoreFocus;
    private Guid? _editingId;
    private LocalLibraryKind _draftKind;
    private string _draftName = string.Empty;
    private string _draftPath = string.Empty;
    private string? _draftServerUrl;
    private string? _draftServerLibrary;
    private string? _error;
    private string? _editorError;
    private bool _draftExternal;
    private int _draftPort = 8080;
    private bool _draftAutostart;
    private bool _draftAutoGitPull;
    private string? _draftInstallation;
    private bool _calibreBusy;

    private string FieldId(string suffix) => $"{_id}-{suffix}";

    private string PathPlaceholder => _draftKind switch
    {
        LocalLibraryKind.Calibre => @"M:\CALIBRE\Books",
        _ => @"C:\ProgrammingProjects\StoryWriting"
    };

    private static string KindLabel(LocalLibraryKind kind) => kind switch
    {
        LocalLibraryKind.Notes => "Notes",
        LocalLibraryKind.Calibre or LocalLibraryKind.CalibreText or LocalLibraryKind.CalibreComic => "Calibre",
        _ => "Unknown kind"
    };

    protected override async Task OnInitializedAsync()
    {
        _token = _lifetime.Token;
        await ReloadAsync();
    }

    private async Task ToggleCalibreAsync(LocalLibraryInstance instance)
    {
        if (_calibreBusy) return;
        _calibreBusy = true;
        _error = null;
        try
        {
            if (!Calibre.GetStatus(instance.Id).IsRunning) await Calibre.StartServerAsync(instance.Id, _token);
            else await Calibre.StopServerAsync(instance.Id);
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception) || exception is System.ComponentModel.Win32Exception or OperationCanceledException)
        {
            _error = exception is InvalidDataException ? exception.Message : "The Calibre server could not be updated.";
        }
        finally
        {
            RefreshAvailability();
            _calibreBusy = false;
        }
    }

    private async Task SaveAutostartAsync(LocalLibraryInstance instance, bool enabled)
    {
        try
        {
            await Store.SaveAsync(instance with { StartWithApp = enabled }, _token);
            await ReloadAsync();
            await NotifyChangedAsync();
        }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "Could not save the autostart setting.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || (!_focusEditor && !_restoreFocus))
        {
            return;
        }

        var target = _focusEditor && _editing ? _nameInput : _heading;
        _focusEditor = false;
        _restoreFocus = false;
        try
        {
            await target.FocusAsync();
        }
        catch (JSException) { }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var instances = await Store.GetAllAsync(_token);
            if (!_disposed)
            {
                _instances = instances;
                RefreshAvailability();
            }
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "Could not load local libraries. Check configuration file access, then retry. Previously loaded libraries are unchanged.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void RefreshAvailability()
    {
        _availability.Clear();
        foreach (var instance in _instances)
        {
            _availability[instance.Id] = instance.IsExternal ? "External" : ValidateRoot(instance.RootPath, instance.Kind) ?? "Available";
        }
    }

    private static string? ValidateRoot(string path, LocalLibraryKind kind)
    {
        if (!Enum.IsDefined(kind))
        {
            return "Select a supported library kind.";
        }

        try
        {
            if (string.IsNullOrWhiteSpace(path) || !Path.IsPathFullyQualified(path))
            {
                return "Enter an absolute server folder path.";
            }

            if (!Directory.Exists(path))
            {
                return "Unavailable: folder does not exist or cannot be accessed.";
            }

            if ((File.GetAttributes(path) & FileAttributes.ReparsePoint) != 0)
            {
                return "Unavailable: the root folder cannot be a symbolic link or junction.";
            }

            if (kind != LocalLibraryKind.Notes && !File.Exists(Path.Combine(path, "metadata.db")))
            {
                return "Unavailable: this Calibre folder must contain metadata.db.";
            }

            return null;
        }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            return "Unavailable: check the server folder path and access permissions.";
        }
    }

    private void AddLibrary()
    {
        _editingId = null;
        _draftKind = FilterKind == LocalLibraryKind.Notes || FilterKind is null ? LocalLibraryKind.Notes : LocalLibraryKind.Calibre;
        _draftName = string.Empty;
        _draftPath = string.Empty;
        _draftServerUrl = _draftServerLibrary = null;
        _draftExternal = _draftAutostart = _draftAutoGitPull = false;
        _draftPort = 8080;
        _draftInstallation = null;
        OpenEditor();
    }

    private void ChangeMode(bool external)
    {
        _draftExternal = external;
        if (!external) _draftServerUrl = _draftServerLibrary = null;
    }

    private void EditLibrary(LocalLibraryInstance instance)
    {
        if (Calibre.GetStatus(instance.Id).IsRunning)
        {
            _error = "Stop Calibre before editing its configuration.";
            return;
        }
        _editingId = instance.Id;
        _draftKind = instance.IsCalibre ? LocalLibraryKind.Calibre : LocalLibraryKind.Notes;
        _draftName = instance.Name;
        _draftPath = instance.RootPath;
        _draftServerUrl = instance.ContentServerUrl?.AbsoluteUri;
        _draftServerLibrary = instance.ContentServerLibraryId;
        _draftExternal = instance.IsExternal;
        _draftPort = instance.ManagedPort;
        _draftAutostart = instance.StartWithApp;
        _draftInstallation = instance.CalibreInstallationFolder;
        _draftAutoGitPull = instance.AutoGitPull;
        OpenEditor();
    }

    private void OpenEditor()
    {
        _editorError = null;
        _editing = true;
        _focusEditor = true;
    }

    private void CancelEdit()
    {
        if (!_busy)
        {
            CloseEditor();
        }
    }

    private void CloseEditor()
    {
        _editing = false;
        _editingId = null;
        _draftName = string.Empty;
        _draftPath = string.Empty;
        _editorError = null;
        _restoreFocus = true;
    }

    private void HandleEditorKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private Task FocusFirstAsync() => _closeButton.FocusAsync().AsTask();
    private Task FocusLastAsync() => (_busy ? _closeButton : _saveButton).FocusAsync().AsTask();

    private async Task SaveAsync()
    {
        if (_busy || _disposed)
        {
            return;
        }

        _editorError = null;
        if (string.IsNullOrWhiteSpace(_draftName) || _draftName.Trim().Length > 60)
        {
            _editorError = "Enter a library name of up to 60 characters.";
            return;
        }

        var external = _draftKind != LocalLibraryKind.Notes && _draftExternal;
        var path = external ? "" : _draftPath.Trim();
        _editorError = external ? null : ValidateRoot(path, _draftKind);
        if (_editorError is not null)
        {
            return;
        }

        Uri? serverUrl = null;
        string? serverLibrary = null;
        if (_draftKind != LocalLibraryKind.Notes)
        {
            if (!string.IsNullOrWhiteSpace(_draftServerUrl) && !Uri.TryCreate(_draftServerUrl.Trim(), UriKind.Absolute, out serverUrl))
            {
                _editorError = "Enter a valid HTTP or HTTPS Content Server URL.";
                return;
            }
            serverLibrary = string.IsNullOrWhiteSpace(_draftServerLibrary) ? null : _draftServerLibrary.Trim();
        }
        var existing = _instances.FirstOrDefault(instance => instance.Id == _editingId);
        var kind = existing?.IsCalibre == true && _draftKind != LocalLibraryKind.Notes ? existing.Kind : _draftKind;
        var instance = new LocalLibraryInstance(_editingId ?? Guid.NewGuid(), _draftName.Trim(), external ? "" : Path.GetFullPath(path), kind, serverUrl, serverLibrary,
            _draftPort, _draftAutostart, string.IsNullOrWhiteSpace(_draftInstallation) ? null : _draftInstallation.Trim(),
            _draftKind == LocalLibraryKind.Notes && _draftAutoGitPull);
        if (!instance.HasValidReaderConfiguration())
        {
            _editorError = "Enter both a Content Server library ID and an HTTP or HTTPS URL without credentials, a query, or a fragment.";
            return;
        }

        _busy = true;
        try
        {
            if (existing is not null && Calibre.GetStatus(existing.Id).IsRunning)
                throw new InvalidDataException("Stop Calibre before editing its configuration.");
            await Store.SaveAsync(instance, _token);
            if (_disposed)
            {
                return;
            }

            _instances = _instances.Where(existing => existing.Id != instance.Id).Append(instance).ToArray();
            RefreshAvailability();
            CloseEditor();
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _editorError = "Could not save this library. Check configuration file access and the server folder, then retry. Your entries are unchanged.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(LocalLibraryInstance instance)
    {
        if (_busy || _disposed)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (!await JavaScript.InvokeAsync<bool>("confirm", _token, $"Remove local library '{instance.Name}'? Only its configuration will be removed. The folder and its files will not be changed."))
            {
                return;
            }

            await Calibre.StopServerAsync(instance.Id);
            if (Calibre.GetStatus(instance.Id).IsRunning)
                throw new InvalidDataException("Calibre could not stop. Retry Stop before removing the library.");
            await Store.RemoveAsync(instance.Id, _token);
            if (_disposed)
            {
                return;
            }

            _instances = _instances.Where(existing => existing.Id != instance.Id).ToArray();
            RefreshAvailability();
            _restoreFocus = true;
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception) || exception is JSException)
        {
            _error = "Could not remove this library. Check the browser connection and configuration file access, then retry. The list is unchanged.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NotifyChangedAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "Library configuration was saved, but the library could not refresh. Reload the page to retry.";
        }
    }

    private static bool IsExpectedFailure(Exception exception) => exception is
        IOException or InvalidDataException or UnauthorizedAccessException or System.Security.SecurityException or
        JsonException or ArgumentException or InvalidOperationException or NotSupportedException or OperationCanceledException;

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}