@using PersonalServerManager.Hydrus
@using System.Security.Cryptography
@using System.Text.Json
@using PersonalServerManager.Management
@implements IDisposable
@inject IHydrusInstanceStore Store
@inject IHydrusClient Client
@inject ManagedBackendService ManagedBackends
@inject IJSRuntime JavaScript

<section class="backend-group hydrus-instances" aria-labelledby="@FieldId("heading")">
    <header class="hydrus-heading">
        <h2 id="@FieldId("heading")">Hydrus</h2>
        <button class="icon-button" type="button" title="Add Hydrus instance" aria-label="Add Hydrus instance" disabled="@(_busy || _loading)" @onclick="AddInstance">
            <MudIcon Icon="@Icons.Material.Filled.Add" aria-hidden="true" />
        </button>
    </header>
    @if (_error is not null)
    {
        <p class="error-message" role="alert">@_error</p>
        <button class="retry-button" type="button" disabled="@(_busy || _loading)" @onclick="ReloadAsync">Retry loading</button>
    }
    @if (_loading)
    {
        <p class="empty-message" role="status">Loading Hydrus instances...</p>
    }
    else if (_instances.Count == 0 && _error is null)
    {
        <p class="empty-message">No Hydrus instances configured.</p>
    }
    <ul class="hydrus-list" aria-label="Hydrus instances">
        @foreach (var instance in _instances)
        {
            var observation = _observations.GetValueOrDefault(instance.Id);
            <li @key="instance.Id">
                <BackendInstanceRow Name="@instance.Name" Type="@(instance.IsManaged ? "Managed" : "External")"
                                    Status="@(observation is null ? "Unknown" : observation.IsReachable ? "Available" : "Unavailable")"
                                    StatusClass="@(observation is null ? "unknown" : observation.IsReachable ? "online" : "offline")"
                                    Selected="@Selection.IsSelected("Hydrus", instance.Id)" OnSelect="() => SelectInstance(instance.Id)">
                    <Actions>
                    @if (instance.IsManaged)
                    {
                        <ManagedBackendControls InstanceId="@instance.Id" InstanceName="@instance.Name" Compact="true" Disabled="@(_busy || _editing)" />
                    }
                    </Actions>
                </BackendInstanceRow>
            </li>
        }
    </ul>
    @if (_editing)
    {
        <div class="hydrus-backdrop" @onkeydown="HandleEditorKey">
            <dialog open class="hydrus-dialog" aria-modal="true" aria-labelledby="@FieldId("editor-title")">
                <MudFocusTrap>
                <header class="editor-heading">
                    <h3 id="@FieldId("editor-title")">@(_editingId is null ? "Add Hydrus instance" : "Edit Hydrus instance")</h3>
                    <button class="icon-button" type="button" title="Close Hydrus editor" aria-label="Close Hydrus editor" disabled="@_busy" @onclick="CancelEdit">
                        <MudIcon Icon="@Icons.Material.Filled.Close" aria-hidden="true" />
                    </button>
                </header>
                @if (_editorError is not null)
                {
                    <p class="error-message" role="alert">@_editorError</p>
                }
                <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                    <fieldset disabled="@_busy">
                        <label for="@FieldId("name")">Hydrus instance name</label>
                        <input id="@FieldId("name")" @bind="_draftName" @bind:event="oninput" maxlength="60" required autofocus />
                        <div class="mode-selector" role="radiogroup" aria-label="Hydrus mode">
                            <label><input type="radio" name="@FieldId("mode")" checked="@(!_draftManaged)" @onchange="() => _draftManaged = false" /> External</label>
                            <label><input type="radio" name="@FieldId("mode")" checked="@_draftManaged" @onchange="() => _draftManaged = true" /> Managed</label>
                        </div>
                        @if (_draftManaged)
                        {
                            <label for="@FieldId("installation")">Hydrus installation folder</label>
                            <input id="@FieldId("installation")" @bind="_draftInstallation" required placeholder="C:\Servers\Hydrus" />
                            <label class="checkbox-label"><input type="checkbox" @bind="_draftAutostart" /> Start with Personal Server Manager</label>
                        }
                        <label for="@FieldId("url")">Client API URL</label>
                        <input id="@FieldId("url")" @bind="_draftUrl" @bind:event="oninput" type="url" required spellcheck="false" aria-describedby="@FieldId("url-help")" />
                        <small id="@FieldId("url-help")">Use HTTP or HTTPS without credentials, a query, or a fragment.</small>
                        <label for="@FieldId("key")">Hydrus access key</label>
                        <input id="@FieldId("key")" @bind="_draftKey" @bind:event="oninput" type="password" required="@(_editingId is null)" maxlength="1024" autocomplete="new-password" spellcheck="false" aria-describedby="@FieldId("key-help")" />
                        <small id="@FieldId("key-help")">@(_editingId is null ? "Create an access key in Hydrus Client API settings with search and retrieve files permissions." : "Leave blank to keep the current key. Enter a key if this instance has none.")</small>
                        <div class="editor-actions">
                            <button class="cancel-button" type="button" @onclick="CancelEdit">Cancel</button>
                            <button class="save-button" type="submit">@(_busy ? "Saving..." : "Save instance")</button>
                        </div>
                    </fieldset>
                </form>
                </MudFocusTrap>
            </dialog>
        </div>
    }
</section>

@foreach (var instance in _instances.Where(instance => Selection.IsSelected("Hydrus", instance.Id)))
{
    var observation = _observations.GetValueOrDefault(instance.Id);
    <section class="backend-details hydrus-instances" aria-label="@($"Hydrus details for {instance.Name}")">
        <header class="details-heading"><h3>@instance.Name</h3><span role="status">@(observation is null ? "Unknown" : observation.IsReachable ? "Available" : "Unavailable")</span></header>
        <dl class="instance-details">
            <dt>Mode</dt><dd>@(instance.IsManaged ? "Managed" : "External")</dd>
            <dt>Client API URL</dt><dd>@instance.ApiEndpoint.AbsoluteUri</dd>
            @if (instance.IsManaged) { <dt>Installation</dt><dd>@instance.InstallationFolder</dd> }
            <dt>Observation</dt><dd>@(observation?.Message is { Length: > 0 } message ? message : "First check pending")</dd>
            @if (observation is not null) { <dt>Last checked</dt><dd>@observation.CheckedAt.ToLocalTime().ToString("g")</dd> }
        </dl>
        @if (instance.IsManaged)
        {
            <ManagedBackendControls @key="instance.Id" InstanceId="@instance.Id" SettingsOnly="true" Disabled="@(_busy || _editing)" StartWithApp="@instance.StartWithApp" StartWithAppChanged="enabled => SaveAutostartAsync(instance, enabled)" />
        }
        <div class="detail-actions">
            <button class="detail-action" type="button" disabled="@_busy" @onclick="() => OpenAsync(instance)"><MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />Open in Hydrus</button>
            <button class="detail-action" type="button" disabled="@_busy" @onclick="() => EditInstance(instance)"><MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />Edit</button>
            <button class="detail-action remove-button" type="button" disabled="@_busy" @onclick="() => RemoveAsync(instance)"><MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />Remove</button>
        </div>
        <p class="permission-note">Client API permissions: search and retrieve files. Manage pages is needed only for the explicit Open in Hydrus action.</p>
    </section>
}

@code {
    [Parameter] public EventCallback Changed { get; set; }
    [CascadingParameter] public BackendSelection Selection { get; set; } = new();
    private BackendSelection? _subscribedSelection;

    private readonly CancellationTokenSource _lifetime = new();
    private readonly string _id = $"hydrus-{Guid.NewGuid():N}";
    private readonly Dictionary<Guid, HydrusObservation> _observations = [];
    private CancellationToken _token;
    private IReadOnlyList<HydrusInstance> _instances = [];
    private bool _loading = true;
    private bool _busy;
    private bool _editing;
    private bool _disposed;
    private Guid? _editingId;
    private string _draftName = string.Empty;
    private string _draftUrl = "http://127.0.0.1:45869/";
    private string _draftKey = string.Empty;
    private bool _draftManaged;
    private string _draftInstallation = string.Empty;
    private bool _draftAutostart;
    private string? _error;
    private string? _editorError;

    private string FieldId(string suffix) => $"{_id}-{suffix}";

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribedSelection, Selection)) return;
        if (_subscribedSelection is not null) _subscribedSelection.Changed -= SelectionChanged;
        _subscribedSelection = Selection;
        _subscribedSelection.Changed += SelectionChanged;
    }

    private void SelectionChanged() => _ = InvokeAsync(StateHasChanged);
    private void SelectInstance(Guid instanceId) => Selection.Select("Hydrus", instanceId);

    protected override async Task OnInitializedAsync()
    {
        _token = _lifetime.Token;
        await ReloadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            _ = ObservePeriodicallyAsync();
        }

        return Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _instances = await Store.GetAllAsync(_token);
            _observations.Clear();
            await RefreshObservationsAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "Could not load Hydrus instances. Check configuration file access and this account's encryption keys, then retry.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshObservationsAsync()
    {
        var snapshot = _instances;
        var observations = await Task.WhenAll(snapshot.Select(async instance =>
        {
            if (string.IsNullOrWhiteSpace(instance.ApiKey))
            {
                return new HydrusObservation(instance.Id, instance.Name, false, DateTimeOffset.UtcNow, string.Empty);
            }

            try
            {
                return await Client.ObserveAsync(instance, _token);
            }
            catch (OperationCanceledException) when (_token.IsCancellationRequested) { throw; }
            catch (Exception exception) when (IsExpectedFailure(exception))
            {
                return new HydrusObservation(instance.Id, instance.Name, false, DateTimeOffset.UtcNow, string.Empty);
            }
        }));

        if (!_disposed && ReferenceEquals(snapshot, _instances))
        {
            foreach (var observation in observations)
            {
                _observations[observation.InstanceId] = observation;
            }
        }
    }

    private async Task ObservePeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(_token))
            {
                await InvokeAsync(async () =>
                {
                    if (!_disposed && !_busy && !_loading)
                    {
                        await RefreshObservationsAsync();
                        if (!_disposed)
                        {
                            StateHasChanged();
                        }
                    }
                });
            }
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (_disposed) { }
    }

    private string StatusText(HydrusInstance instance)
    {
        if (string.IsNullOrWhiteSpace(instance.ApiKey))
        {
            return "Access key missing. Edit this instance to add one.";
        }

        return !_observations.TryGetValue(instance.Id, out var observation)
            ? "Checking..."
            : observation.IsReachable ? "Available" : "Unavailable. Check Client API, URL, key, and permissions.";
    }

    private void AddInstance()
    {
        _editingId = null;
        _draftName = string.Empty;
        _draftUrl = "http://127.0.0.1:45869/";
        _draftKey = string.Empty;
        _editorError = null;
        _draftManaged = false;
        _draftInstallation = string.Empty;
        _draftAutostart = false;
        _editing = true;
    }

    private void EditInstance(HydrusInstance instance)
    {
        if (ManagedBackends.GetStatus(instance.Id).IsRunning)
        {
            _error = "Stop Hydrus before editing its configuration.";
            return;
        }
        _editingId = instance.Id;
        _draftName = instance.Name;
        _draftUrl = instance.ApiEndpoint.AbsoluteUri;
        _draftKey = string.Empty;
        _editorError = null;
        _draftManaged = instance.IsManaged;
        _draftInstallation = instance.InstallationFolder ?? string.Empty;
        _draftAutostart = instance.StartWithApp;
        _editing = true;
    }

    private void CancelEdit()
    {
        if (!_busy)
        {
            CloseEditor();
        }
    }

    private void CloseEditor()
    {
        _draftKey = string.Empty;
        _draftName = string.Empty;
        _draftUrl = "http://127.0.0.1:45869/";
        _editingId = null;
        _editorError = null;
        _editing = false;
    }

    private void HandleEditorKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private async Task SaveAsync()
    {
        if (_busy || _disposed)
        {
            return;
        }

        _editorError = null;
        if (string.IsNullOrWhiteSpace(_draftName) || _draftName.Trim().Length > 60)
        {
            _editorError = "Enter a Hydrus instance name of up to 60 characters.";
            _draftKey = string.Empty;
            return;
        }

        if (!Uri.TryCreate(_draftUrl.Trim(), UriKind.Absolute, out var endpoint) ||
            (endpoint.Scheme != Uri.UriSchemeHttp && endpoint.Scheme != Uri.UriSchemeHttps) ||
            string.IsNullOrEmpty(endpoint.Host) || !string.IsNullOrEmpty(endpoint.UserInfo) ||
            !string.IsNullOrEmpty(endpoint.Query) || !string.IsNullOrEmpty(endpoint.Fragment))
        {
            _editorError = "Enter an HTTP or HTTPS Client API URL without credentials, a query, or a fragment.";
            _draftKey = string.Empty;
            return;
        }

        var previous = _instances.FirstOrDefault(instance => instance.Id == _editingId);
        if (_editingId is not null && previous is null)
        {
            _editorError = "The Hydrus instance no longer exists.";
            _draftKey = string.Empty;
            return;
        }
        var apiKey = string.IsNullOrWhiteSpace(_draftKey) ? previous?.ApiKey : _draftKey.Trim();
        if (string.IsNullOrWhiteSpace(apiKey) || apiKey.Length > 1024 || apiKey.Any(character => character < ' ' || character > '~'))
        {
            _editorError = "Enter a valid Hydrus access key from Client API settings. The key must contain only printable ASCII characters.";
            _draftKey = string.Empty;
            return;
        }

        _busy = true;
        try
        {
            var instance = new HydrusInstance(_editingId ?? Guid.NewGuid(), _draftName.Trim(), endpoint, apiKey,
                _draftManaged ? _draftInstallation.Trim() : null, _draftManaged && _draftAutostart);
            _draftKey = string.Empty;
            if (_editingId is null) await Store.SaveAsync(instance, _token);
            else await ManagedBackends.UpdateInstanceAsync(instance, _token);
            CloseEditor();
            await ReloadAsync();
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _editorError = exception is InvalidDataException && (exception.Message == "The Hydrus instance no longer exists."
                || exception.Message == "Stop Hydrus before editing its configuration.")
                ? exception.Message : "Could not save this instance. Check configuration file access and this account's encryption keys, then re-enter the access key and retry.";
        }
        finally
        {
            _draftKey = string.Empty;
            _busy = false;
        }
    }

    private async Task RemoveAsync(HydrusInstance instance)
    {
        if (_busy || _disposed)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var confirmation = instance.IsManaged
                ? $"Remove {instance.Name}? Its PSM-managed Hydrus service will be stopped. Local files will be kept."
                : $"Remove {instance.Name}? The external Hydrus client will keep running and its files will not be changed.";
            if (!await JavaScript.InvokeAsync<bool>("confirm", _token, confirmation))
            {
                return;
            }

            await ManagedBackends.RemoveInstanceAsync("Hydrus", instance.Id, _token);
            Selection.Clear("Hydrus", instance.Id);
            await ReloadAsync();
            await NotifyChangedAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (InvalidDataException exception)
        {
            _error = exception.Message;
        }
        catch (Exception exception) when (IsExpectedFailure(exception) || exception is JSException)
        {
            _error = "Could not remove this instance. Check the browser connection and configuration file access, then retry.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenAsync(HydrusInstance instance)
    {
        if (_busy || _disposed) return;
        _busy = true;
        _error = null;
        try { await Client.OpenSearchAsync(instance, [], _token); }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "Could not open a Hydrus page. Check the Client API and manage pages permission.";
        }
        finally { _busy = false; }
    }

    private async Task NotifyChangedAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = "The instance configuration was saved, but the library could not refresh. Reload the page to retry.";
        }
    }

    private async Task SaveAutostartAsync(HydrusInstance instance, bool enabled)
    {
        try
        {
            await Store.UpdateAsync(instance with { StartWithApp = enabled }, _token);
            _instances = await Store.GetAllAsync(_token);
            await NotifyChangedAsync();
        }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            _error = exception is InvalidDataException && exception.Message == "The Hydrus instance no longer exists."
                ? exception.Message : "Could not save the autostart setting.";
        }
    }

    private static bool IsExpectedFailure(Exception exception) => exception is
        IOException or InvalidDataException or CryptographicException or ArgumentException or
        UnauthorizedAccessException or System.Security.SecurityException or JsonException or
        HttpRequestException or OperationCanceledException or InvalidOperationException or FormatException or KeyNotFoundException;

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        if (_subscribedSelection is not null) _subscribedSelection.Changed -= SelectionChanged;
        _draftKey = string.Empty;
        _instances = [];
        _observations.Clear();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}