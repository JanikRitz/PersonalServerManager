@page "/feeds"
@page "/feeds/{FeedId:guid}"
@using System.Globalization
@using PersonalServerManager.Feeds
@implements IAsyncDisposable
@inject IFeedStore Store
@inject FeedService FeedService
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>@(_activeId is null ? "Feeds" : ActiveName) | Personal Server Manager</PageTitle>

<div class="feed-shell" tabindex="0" @onkeydown="ViewerKeyAsync">
    <header class="feed-topbar" data-no-swipe="true">
        <a class="glass-btn" href="/" aria-label="Library search" title="Back to search">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
        </a>

        @if (_feeds.Count > 0)
        {
            <div class="switcher-wrap">
                <select class="feed-switcher" aria-label="Select feed" value="@(_activeId?.ToString("D") ?? "")" @onchange="OnFeedSelectedAsync">
                    @foreach (var feed in _feeds)
                    {
                        <option value="@feed.Id.ToString("D")">@feed.Name</option>
                    }
                </select>
                <span class="switcher-chevron" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" /></span>
            </div>
        }
        else
        {
            <span class="topbar-title">Feeds</span>
        }

        <div class="topbar-end">
            @if (_items.Count > 0)
            {
                <span class="counter-pill" role="status">@(_index + 1) / @_items.Count@(_hasMore ? "+" : "")</span>
            }
            <a class="glass-btn manage-btn" href="/feeds/manage" aria-label="Manage feeds" title="Manage feeds">
                <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                <span class="manage-label">Manage</span>
            </a>
        </div>
    </header>

    @if (_error is not null || (_pageErrors.Count > 0 && !_errorsDismissed))
    {
        <div class="toast-stack" data-no-swipe="true" role="status">
            @if (_error is not null)
            {
                <div class="toast-notice">@_error</div>
            }
            @foreach (var failure in _pageErrors.Distinct())
            {
                <div class="toast-notice">
                    <span>@failure</span>
                    <button class="toast-close" type="button" aria-label="Dismiss notice" @onclick="() => _errorsDismissed = true">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            }
        </div>
    }

    <main class="feed-stage" aria-label="Feed viewer">
        @if (!_loaded)
        {
            <div class="stage-state" role="status">
                <span class="stage-spinner" aria-hidden="true"></span>
                <p>Loading feeds...</p>
            </div>
        }
        else if (_feeds.Count == 0)
        {
            <div class="stage-state">
                <h1>No feeds yet</h1>
                <p>Create a feed to swipe through your Stash, Hydrus, and SwarmUI libraries.</p>
                <a class="stage-cta" href="/feeds/manage"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />Create a feed</a>
            </div>
        }
        else if (_items.Count > 0)
        {
            var item = _items[_index];
            var useFallback = _useFallback && item.FallbackMediaUrl is not null;
            var activeUrl = useFallback ? item.FallbackMediaUrl! : item.MediaUrl;
            var activeIsVideo = useFallback ? item.FallbackIsVideo : item.IsVideo;
            var durationText = FormatItemTiming(item);
            var score = item.RatingOutOfFive?.ToString("0.##", CultureInfo.InvariantCulture);
            var ratingLabel = score is not null ? $"Rated {score} out of 5" : item.IsFavorite ? "Favorite" : null;

            <div class="feed-media-wrap">
                @if (activeIsVideo)
                {
                    <video @ref="_videoElement"
                           @key="(_activeId, _index, useFallback)"
                           class="feed-media"
                           src="@activeUrl"
                           poster="@item.PosterUrl"
                           autoplay
                           loop
                           playsinline
                           muted="@_muted"
                           preload="auto"
                           aria-label="@item.Title"
                           @onclick="TogglePlaybackAsync"
                           @onerror="MediaFailed"></video>
                    @if (_paused)
                    {
                        <div class="pause-indicator" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Large" />
                        </div>
                    }
                }
                else
                {
                    <img @key="(_activeId, _index, useFallback)"
                         class="feed-media"
                         src="@activeUrl"
                         alt="@item.Title"
                         @onerror="MediaFailed" />
                }
            </div>

            @if (_mediaError)
            {
                <div class="media-error-card" role="alert" data-no-swipe="true">
                    <p>This media could not be played in the browser.</p>
                    <div class="media-error-actions">
                        <a class="stage-cta" href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">Open in @item.SourceName <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /></a>
                        @if (_index + 1 < _items.Count || _hasMore)
                        {
                            <button class="glass-pill" type="button" @onclick="NextAsync">Skip</button>
                        }
                    </div>
                </div>
            }

            <div class="bottom-scrim" aria-hidden="true"></div>

            <aside class="action-rail @(activeIsVideo ? "has-scrubber" : "")" aria-label="Media controls" data-no-swipe="true">
                @if (activeIsVideo)
                {
                    <button class="rail-btn" type="button"
                            aria-label="@(_muted ? "Unmute video" : "Mute video")"
                            aria-pressed="@(_muted ? "false" : "true")"
                            title="@(_muted ? "Unmute (M)" : "Mute (M)")"
                            @onclick="ToggleMuteAsync">
                        <MudIcon Icon="@(_muted ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)" />
                        <span>@(_muted ? "Muted" : "Sound")</span>
                    </button>
                    <button class="rail-btn" type="button"
                            aria-label="@(_paused ? "Play video" : "Pause video")"
                            title="@(_paused ? "Play (Space)" : "Pause (Space)")"
                            @onclick="TogglePlaybackAsync">
                        <MudIcon Icon="@(_paused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)" />
                        <span>@(_paused ? "Play" : "Pause")</span>
                    </button>
                }
                <a class="rail-btn" href="@item.SourceUrl" target="_blank" rel="noopener noreferrer"
                   title="Open in @item.SourceName"
                   aria-label="Open @item.Title in @item.SourceName">
                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" />
                    <span>Source</span>
                </a>
                <button class="rail-btn" type="button"
                        aria-label="Previous item"
                        title="Previous (Up)"
                        disabled="@(_index == 0)"
                        @onclick="Previous">
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowUp" />
                </button>
                <button class="rail-btn" type="button"
                        aria-label="Next item"
                        title="Next (Down)"
                        disabled="@(_index + 1 >= _items.Count && (!_hasMore || _loading))"
                        @onclick="NextAsync">
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" />
                </button>
            </aside>

            <section class="info-overlay @(activeIsVideo ? "has-scrubber" : "")" aria-label="Item details" data-no-swipe="true" @onclick="() => _expandedInfo = !_expandedInfo">
                <div class="badge-row">
                    <span class="info-badge source">@item.SourceName</span>
                    @if (!string.IsNullOrWhiteSpace(item.MediaKind))
                    {
                        <span class="info-badge kind">@item.MediaKind</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.FileFormat))
                    {
                        <span class="info-badge format">@item.FileFormat</span>
                    }
                    @if (durationText is not null)
                    {
                        <span class="info-badge timing">@durationText</span>
                    }
                    @if (ratingLabel is not null)
                    {
                        <span class="info-badge rating" title="@ratingLabel" aria-label="@ratingLabel">&#9733;@(score is null ? null : $" {score}/5")</span>
                    }
                </div>
                <h1 class="item-title @(_expandedInfo ? "expanded" : "")" title="@item.Title">@item.Title</h1>
                @if (!string.IsNullOrWhiteSpace(item.Description))
                {
                    <p class="item-desc @(_expandedInfo ? "expanded" : "")">@item.Description</p>
                }
                @if (!_hasMore && _index == _items.Count - 1)
                {
                    <span class="end-pill">End of feed</span>
                }
                else if (_loading)
                {
                    <span class="end-pill">Loading more...</span>
                }
            </section>

            @if (activeIsVideo)
            {
                <div @ref="_scrubberElement"
                     @key="(_activeId, _index, useFallback)"
                     class="video-scrubber @(_paused ? "is-paused" : "")"
                     role="slider"
                     tabindex="0"
                     aria-label="Video progress"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="0"
                     data-no-swipe="true">
                    <span class="scrubber-time" aria-hidden="true">0:00</span>
                    <div class="scrubber-track" aria-hidden="true">
                        <div class="scrubber-buffered"></div>
                        <div class="scrubber-fill">
                            <span class="scrubber-handle"></span>
                        </div>
                    </div>
                </div>
            }
        }
        else if (_loading || !_interactive)
        {
            <div class="stage-state" role="status">
                <span class="stage-spinner" aria-hidden="true"></span>
                <p>Loading @ActiveName...</p>
            </div>
        }
        else
        {
            <div class="stage-state">
                <h1>Nothing to show</h1>
                <p>@(_pageErrors.Count > 0 ? "No items are available from the remaining sources." : "No items matched this feed.")</p>
                <div class="media-error-actions">
                    @if (_hasMore)
                    {
                        <button class="stage-cta" type="button" @onclick="LoadNextAsync">Try loading more</button>
                    }
                    <a class="glass-pill" href="/feeds/manage">Edit feeds</a>
                </div>
            </div>
        }
    </main>
</div>

@code {
    [Parameter] public Guid? FeedId { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<FeedDefinition> _feeds = [];
    private readonly List<FeedItem> _items = [];
    private readonly List<string> _pageErrors = [];
    private FeedSession? _session;
    private Guid? _activeId;
    private string? _error;
    private int _index, _generation;
    private bool _loaded, _interactive, _loading, _hasMore, _disposed, _mediaError, _useFallback, _muted = true, _paused, _expandedInfo, _errorsDismissed;
    private ElementReference _videoElement, _scrubberElement;
    private string? _syncedVideoKey, _preloadKey;
    private IJSObjectReference? _gestureModule, _gestureListener;
    private DotNetObjectReference<Feeds>? _gestureTarget;

    private string ActiveName => _feeds.FirstOrDefault(feed => feed.Id == _activeId)?.Name ?? "Feed";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _feeds = await Store.GetAllAsync(_lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            _error = $"Could not load feed configuration: {exception.Message}";
        }
        finally
        {
            _loaded = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_interactive) return;
        await EnsureActiveFeedAsync();
    }

    private async Task EnsureActiveFeedAsync()
    {
        if (_feeds.Count == 0) return;
        var target = FeedId is { } id
            ? _feeds.FirstOrDefault(feed => feed.Id == id) ?? _feeds[0]
            : _feeds[0];
        if (target.Id != _activeId)
        {
            await OpenFeedAsync(target);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _interactive = true;
            try
            {
                _gestureModule = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./feed-gestures.js");
                if (_disposed) { await _gestureModule.DisposeAsync(); return; }
                _gestureTarget = DotNetObjectReference.Create(this);
                _gestureListener = await _gestureModule.InvokeAsync<IJSObjectReference>("initialize", _gestureTarget);
                if (_disposed) { await _gestureListener.InvokeVoidAsync("dispose"); await _gestureListener.DisposeAsync(); }
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { if (!_disposed) { _error = "Swipe navigation is unavailable. Use the arrow buttons instead."; StateHasChanged(); } }

            await EnsureActiveFeedAsync();
            if (!_disposed) StateHasChanged();
        }

        if (_gestureModule is not null && _items.Count > 0)
        {
            var item = _items[_index];
            var useFallback = _useFallback && item.FallbackMediaUrl is not null;
            var activeIsVideo = useFallback ? item.FallbackIsVideo : item.IsVideo;
            var key = $"{_activeId}:{_index}:{useFallback}";
            if (activeIsVideo && _syncedVideoKey != key)
            {
                _syncedVideoKey = key;
                try { await _gestureModule.InvokeAsync<bool>("syncVideo", _videoElement, _scrubberElement, _muted); }
                catch (JSException) { }
                catch (JSDisconnectedException) { }
            }
            else if (!activeIsVideo && _syncedVideoKey is not null)
            {
                _syncedVideoKey = null;
                try { await _gestureModule.InvokeVoidAsync("clearScrubber"); }
                catch (JSException) { }
                catch (JSDisconnectedException) { }
            }

            var preloadKey = $"{_activeId}:{_index}:{_items.Count}";
            if (_preloadKey != preloadKey)
            {
                _preloadKey = preloadKey;
                try { await _gestureModule.InvokeVoidAsync("preloadMedia", BuildPreloadTargets()); }
                catch (JSException) { }
                catch (JSDisconnectedException) { }
            }
        }
    }

    private async Task OnFeedSelectedAsync(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var id) || id == _activeId) return;
        var feed = _feeds.FirstOrDefault(item => item.Id == id);
        if (feed is null) return;
        Navigation.NavigateTo($"/feeds/{feed.Id:D}", replace: true);
        await OpenFeedAsync(feed);
    }

    private void ClearViewer()
    {
        _generation++;
        _session = null;
        _activeId = null;
        _items.Clear();
        _pageErrors.Clear();
        _loading = false;
        _hasMore = false;
        _mediaError = false;
        _useFallback = false;
        _paused = false;
        _expandedInfo = false;
        _errorsDismissed = false;
        _syncedVideoKey = null;
        _preloadKey = null;
        _index = 0;
    }

    private async Task OpenFeedAsync(FeedDefinition feed)
    {
        ClearViewer();
        _activeId = feed.Id;
        try
        {
            _session = FeedService.Start(feed);
            _hasMore = true;
            await LoadNextAsync();
            if (!_disposed && _items.Count > 0 && _index + 5 >= _items.Count && _hasMore && !_loading)
            {
                _ = LoadNextInBackgroundAsync(_generation);
            }
        }
        catch (Exception exception)
        {
            _pageErrors.Add($"Could not open feed: {exception.Message}");
        }
    }

    private async Task LoadNextAsync()
    {
        if (_loading || !_hasMore || _session is null) return;
        var generation = _generation;
        var session = _session;
        _loading = true;
        try
        {
            var page = await session.LoadNextAsync(_lifetime.Token);
            if (_disposed || generation != _generation) return;
            _items.AddRange(page.Items);
            _pageErrors.AddRange(page.Errors);
            _hasMore = page.HasMore;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (!_disposed && generation == _generation) _pageErrors.Add($"Could not load feed: {exception.Message}");
        }
        finally
        {
            if (generation == _generation) _loading = false;
        }
    }

    private void MediaFailed()
    {
        if (_items.Count > 0 && !_useFallback && _items[_index].FallbackMediaUrl is not null)
        {
            _useFallback = true;
            _paused = false;
            _syncedVideoKey = null;
            return;
        }
        _mediaError = true;
    }

    private void ResetItemState()
    {
        _mediaError = false;
        _useFallback = false;
        _paused = false;
        _expandedInfo = false;
        _syncedVideoKey = null;
    }

    private void Previous()
    {
        if (_index > 0)
        {
            _index--;
            ResetItemState();
        }
    }

    private async Task NextAsync()
    {
        var generation = _generation;
        if (_index + 1 >= _items.Count && _hasMore) await LoadNextAsync();
        if (_disposed || generation != _generation) return;
        if (_index + 1 < _items.Count)
        {
            _index++;
            ResetItemState();
            StateHasChanged();
        }
        if (_index + 5 >= _items.Count && _hasMore && !_loading) _ = LoadNextInBackgroundAsync(generation);
    }

    private IReadOnlyList<PreloadTarget> BuildPreloadTargets()
    {
        var targets = new List<PreloadTarget>(4);
        AddPreloadTarget(targets, _index + 1, fullPreload: true);
        AddPreloadTarget(targets, _index + 2, fullPreload: false);
        AddPreloadTarget(targets, _index + 3, fullPreload: false);
        AddPreloadTarget(targets, _index - 1, fullPreload: false);
        return targets;
    }

    private void AddPreloadTarget(List<PreloadTarget> targets, int itemIndex, bool fullPreload)
    {
        if (itemIndex < 0 || itemIndex >= _items.Count) return;
        var item = _items[itemIndex];
        var mediaUrl = item.MediaUrl.ToString();
        if (string.IsNullOrWhiteSpace(mediaUrl)) return;
        targets.Add(new PreloadTarget(mediaUrl, item.IsVideo, fullPreload, item.PosterUrl?.ToString()));
    }

    private sealed record PreloadTarget(string Url, bool IsVideo, bool FullPreload, string? PosterUrl);

    private async Task LoadNextInBackgroundAsync(int generation)
    {
        await LoadNextAsync();
        if (!_disposed && generation == _generation) await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleMuteAsync()
    {
        _muted = !_muted;
        if (_gestureModule is not null)
        {
            try { await _gestureModule.InvokeVoidAsync("setMuted", _videoElement, _muted); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task TogglePlaybackAsync()
    {
        if (_gestureModule is null) return;
        try { _paused = await _gestureModule.InvokeAsync<bool>("togglePlay", _videoElement); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    private async Task ViewerKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key is "ArrowUp" or "ArrowLeft") Previous();
        else if (args.Key is "ArrowDown" or "ArrowRight") await NextAsync();
        else if (args.Key == " " && _items.Count > 0) await TogglePlaybackAsync();
        else if (args.Key is "m" or "M" && _items.Count > 0) await ToggleMuteAsync();
    }

    [JSInvokable]
    public Task SwipeAsync(bool next) => InvokeAsync(async () =>
    {
        if (_disposed) return;
        if (next) await NextAsync(); else Previous();
        if (!_disposed) StateHasChanged();
    });

    private static string? FormatItemTiming(FeedItem item)
    {
        if (item.MarkerStart is { } start)
        {
            var text = FormatDuration(start);
            return item.MarkerEnd is { } end ? $"{text} - {FormatDuration(end)}" : text;
        }
        return item.Duration is { } duration ? FormatDuration(duration) : null;
    }

    private static string FormatDuration(TimeSpan duration) =>
        duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}:{duration.Minutes:00}:{duration.Seconds:00}"
            : $"{duration.Minutes}:{duration.Seconds:00}";

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _generation++;
        _lifetime.Cancel();
        try
        {
            if (_gestureListener is not null) { await _gestureListener.InvokeVoidAsync("dispose"); await _gestureListener.DisposeAsync(); }
            if (_gestureModule is not null) await _gestureModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally
        {
            _gestureTarget?.Dispose();
            _lifetime.Dispose();
        }
    }
}