@page "/"
@using System.Text.Json
@using PersonalServerManager.Stash
@using PersonalServerManager.Hydrus
@using PersonalServerManager.Search
@implements IDisposable
@inject IStashInstanceStore InstanceStore
@inject IHydrusInstanceStore HydrusStore
@inject IHydrusClient HydrusClient
@inject LibrarySearchService LibrarySearch

<PageTitle>Library search | Personal Server Manager</PageTitle>

<div class="workspace @(_searchHasRun ? "has-results" : string.Empty)">
    <header class="topbar">
        <a class="wordmark" href="/" aria-label="Personal Server Manager home"><span class="mark">P</span><span>Personal Server Manager</span></a>
        <nav class="topbar-right" aria-label="Workspace">
            <a class="icon-action" href="/backends" aria-label="Manage backends" title="Manage backends"><MudIcon Icon="@Icons.Material.Outlined.Settings" /></a>
            <form method="post" action="/account/logout"><AntiforgeryToken /><button class="logout" type="submit">Sign out</button></form>
        </nav>
    </header>

    <main>
        <section class="search-section" aria-labelledby="search-heading">
            @if (_pageError is not null)
            {
                <div class="notice error-notice" role="alert">@_pageError</div>
            }
            <form class="search-form" role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <label class="visually-hidden" for="search-query">Search all libraries</label>
                <span class="search-glyph" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Search" /></span>
                <input id="search-query" type="search" @bind="_query" @bind:event="oninput" maxlength="1024" placeholder="Search all libraries" autocomplete="off" />
                <button class="search-button" type="submit" title="Search" aria-label="@(_isSearching ? "Searching" : "Search")" disabled="@(_isSearching || _openingHydrus is not null || string.IsNullOrWhiteSpace(_query))"><MudIcon Icon="@(_isSearching ? Icons.Material.Outlined.HourglassEmpty : Icons.Material.Outlined.ArrowForward)" /></button>
            </form>
            @if (_configurationLoaded && _instances.Count + _hydrusInstances.Count == 0 && _pageError is null)
            {
                <p class="empty-state">No backends connected. <a href="/backends">Add a backend</a></p>
            }
            @if (_searchHasRun)
            {
                <div class="results-header" role="status" aria-live="polite"><h2>Results <span>@_groups.Sum(group => group.Items.Count)</span></h2><span>@(_isSearching ? "Searching all libraries..." : $"for '{_submittedQuery}'")</span></div>
                <div class="results" aria-busy="@_isSearching.ToString().ToLowerInvariant()">
                    @foreach (var group in _groups)
                    {
                        <section class="result-group" aria-label="@(group.InstanceName + " " + group.Category)">
                            <div class="group-heading"><h3>@group.Category <small>@group.Provider / @group.InstanceName</small></h3>
                                @if (group.SearchUrl is not null)
                                {
                                    <a class="text-action" href="@group.SearchUrl" target="_blank" rel="noopener noreferrer">Open full query in Stash <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /></a>
                                }
                                else
                                {
                                    <button class="text-action" type="button" disabled="@(_openingHydrus is not null)" title="Create and focus a search page in the Hydrus desktop client" @onclick="() => OpenHydrusAsync(group.InstanceId)">@(_openingHydrus == group.InstanceId ? "Opening Hydrus..." : "Open query in Hydrus") <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /></button>
                                }
                            </div>
                            @if (group.Error is not null)
                            {
                                <div class="instance-error" role="status">@group.Error</div>
                            }
                            else if (group.Items.Count == 0)
                            {
                                <p class="group-empty">No matches</p>
                            }
                            else
                            {
                                <ul class="group-results">
                                    @foreach (var item in group.Items)
                                    {
                                        <li>
                                            <div class="result-preview" aria-hidden="true">
                                                <MudIcon Icon="@Icons.Material.Outlined.Image" />
                                                @if (item.PreviewUrl is not null)
                                                {
                                                    <img src="@item.PreviewUrl" alt="" loading="lazy" onerror="this.hidden=true" />
                                                }
                                            </div>
                                            <div class="result-copy">
                                                @if (item.ItemUrl is not null)
                                                {
                                                    <a href="@item.ItemUrl" target="_blank" rel="noopener noreferrer"><span>@item.Title</span><MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /></a>
                                                }
                                                else
                                                {
                                                    <span>@item.Title</span>
                                                }
                                                <small>@item.Detail</small>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                </div>
            }
            @if (_hydrusActionMessage is not null)
            {
                <p role="status" class="notice">@_hydrusActionMessage</p>
            }
        </section>
    </main>
    <footer><span>PERSONAL SERVER MANAGER</span><span>STASH / HYDRUS</span></footer>
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<StashInstance> _instances = [];
    private IReadOnlyList<HydrusInstance> _hydrusInstances = [];
    private IReadOnlyList<LibraryGroup> _groups = [];
    private string _query = string.Empty;
    private string _submittedQuery = string.Empty;
    private string? _pageError;
    private string? _hydrusActionMessage;
    private Guid? _openingHydrus;
    private bool _configurationLoaded;
    private bool _searchHasRun;
    private bool _isSearching;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _instances = await InstanceStore.GetAllAsync(_lifetime.Token);
            _hydrusInstances = await HydrusStore.GetAllAsync(_lifetime.Token);
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UriFormatException or System.Security.Cryptography.CryptographicException or UnauthorizedAccessException)
        {
            _pageError = "Backend configuration could not be loaded. Check the data directory and Windows account; existing data was not changed.";
        }
        _configurationLoaded = true;
    }

    private async Task SearchAsync()
    {
        if (_isSearching || _openingHydrus is not null || string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        _isSearching = true;
        _searchHasRun = true;
        _groups = [];
        _hydrusActionMessage = null;
        _submittedQuery = _query.Trim();
        try
        {
            _groups = await LibrarySearch.SearchAsync(_instances, _hydrusInstances, _submittedQuery, _lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task OpenHydrusAsync(Guid instanceId)
    {
        if (_openingHydrus is not null || _isSearching)
        {
            return;
        }

        var instance = _hydrusInstances.FirstOrDefault(instance => instance.Id == instanceId);
        if (instance is null)
        {
            return;
        }

        _openingHydrus = instanceId;
        try
        {
            await HydrusClient.OpenSearchAsync(instance, LibrarySearchService.ParseHydrusTags(_submittedQuery), _lifetime.Token);
            _hydrusActionMessage = $"Opened the full query in {instance.Name}'s Hydrus desktop client.";
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidDataException or JsonException or ArgumentException)
        {
            _hydrusActionMessage = "Could not open the Hydrus search page. Check connectivity and the access key's manage-pages permission.";
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _openingHydrus = null;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}