@page "/"
@using System.Text.Json
@using PersonalServerManager.Stash
@using PersonalServerManager.Hydrus
@using PersonalServerManager.Search
@using PersonalServerManager.LocalLibraries
@implements IDisposable
@inject IStashInstanceStore InstanceStore
@inject IHydrusInstanceStore HydrusStore
@inject IHydrusClient HydrusClient
@inject LibrarySearchService LibrarySearch
@inject ILocalLibraryStore LocalStore

<PageTitle>Library search | Personal Server Manager</PageTitle>

<div class="workspace @(_searchHasRun ? "has-results" : string.Empty)">
    <header class="topbar">
        <a class="wordmark" href="/" aria-label="Personal Server Manager home"><span class="mark">P</span><span>Personal Server Manager</span></a>
        <nav class="topbar-right" aria-label="Workspace">
            <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Toggle dark mode"><span class="theme-moon"><MudIcon Icon="@Icons.Material.Outlined.DarkMode" /></span><span class="theme-sun"><MudIcon Icon="@Icons.Material.Outlined.LightMode" /></span></button>
            <a class="icon-action" href="/backends" aria-label="Manage backends" title="Manage backends"><MudIcon Icon="@Icons.Material.Outlined.Settings" /></a>
            <form method="post" action="/account/logout"><AntiforgeryToken /><button class="logout" type="submit">Sign out</button></form>
        </nav>
    </header>

    <main>
        <section class="search-section" aria-label="Library search">
            @if (_pageError is not null)
            {
                <div class="notice error-notice" role="alert">@_pageError</div>
            }
            <form class="search-form" role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <label class="visually-hidden" for="search-query">Search all libraries</label>
                <span class="search-glyph" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Search" /></span>
                <input id="search-query" type="search" @bind="_query" @bind:event="oninput" maxlength="1024" placeholder="Search all libraries" autocomplete="off" />
                <button class="search-button" type="submit" title="Search" aria-label="@(_isSearching ? "Searching" : "Search")" disabled="@(_isSearching || _expandingType is not null || _openingHydrus is not null || string.IsNullOrWhiteSpace(_query))"><MudIcon Icon="@(_isSearching ? Icons.Material.Outlined.HourglassEmpty : Icons.Material.Outlined.ArrowForward)" /></button>
            </form>
            @if (_configurationLoaded && _instances.Count + _hydrusInstances.Count + _localLibraries.Count == 0 && _pageError is null)
            {
                <p class="empty-state">No backends connected. <a href="/backends">Add a backend</a></p>
            }
            @if (_searchHasRun)
            {
                @if (_isSearching)
                {
                    <div class="search-loading" role="status" aria-live="polite">
                        <span class="loading-spinner" aria-hidden="true"></span>
                        <div><h2>Searching your libraries</h2><p>Fetching results for '@_submittedQuery'</p></div>
                    </div>
                    <progress class="search-progress" aria-label="Fetching search results"></progress>
                    <div class="loading-grid" aria-hidden="true">
                        @for (var index = 0; index < 5; index++)
                        {
                            <div class="loading-tile"><span class="loading-thumbnail"></span><span class="loading-line"></span><span class="loading-line short"></span></div>
                        }
                    </div>
                }
                else
                {
                    <div class="results-header" role="status" aria-live="polite"><h2>Results <span>@VisibleResultCount</span></h2><span>for '@_submittedQuery'</span></div>
                }
                @foreach (var failure in (_expandedGroups ?? _groups).Where(group => group.Error is not null))
                {
                    <p class="instance-error" role="status">@failure.InstanceName / @failure.Category: @failure.Error</p>
                }
                @if (!_isSearching && _typeGroups.Count == 0)
                {
                    <p class="empty-state">@(_groups.Any(group => group.Error is not null) ? "No results available from the remaining backends." : "No results found.")</p>
                }
                <div class="results" aria-busy="@(_isSearching || _expandingType is not null ? "true" : "false")">
                    @foreach (var group in _typeGroups)
                    {
                        var expanded = _expandedTypes.Contains(group.Type);
                        var resultsId = $"results-{group.Type}";
                        <section class="result-group" aria-label="@TypeLabel(group.Type)" @key="group.Type">
                            <div class="group-heading">
                                <h3>@TypeLabel(group.Type)</h3>
                                <button class="text-action expand-action" type="button" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@resultsId" disabled="@(_expandingType is not null || _openingHydrus is not null)" @onclick="() => ToggleExpandedAsync(group.Type)">
                                    @(_expandingType == group.Type ? "Loading..." : expanded ? "Show less" : "Show up to 25")
                                    <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                                </button>
                            </div>
                            @if (_expandingType == group.Type)
                            {
                                <div class="expansion-loading" role="status"><span class="loading-spinner" aria-hidden="true"></span><span>Fetching more @TypeLabel(group.Type) results...</span></div>
                                <progress class="search-progress" aria-label="@($"Fetching more {TypeLabel(group.Type)} results")"></progress>
                            }
                            <ul class="media-grid" id="@resultsId">
                                @foreach (var entry in group.Items.Take(expanded ? 25 : 5))
                                {
                                    var item = entry.Item;
                                    <li class="media-tile" @key="(entry.Source.InstanceId, entry.Source.Category, item.Id)">
                                        <a class="thumbnail-link" href="@(item.ItemUrl ?? item.PreviewUrl)" target="_blank" rel="noopener noreferrer" aria-label="@(item.ItemUrl is null ? $"View preview: {item.Title}" : $"Open {item.Title} in {entry.Source.InstanceName}")">
                                            <span class="thumbnail-placeholder" aria-hidden="true"><MudIcon Icon="@TypeIcon(group.Type)" /></span>
                                            @if (item.PreviewUrl is not null)
                                            {
                                                <img class="thumbnail" src="@item.PreviewUrl" alt="" loading="lazy" onerror="this.hidden=true" />
                                                <span class="thumbnail-zoom" aria-hidden="true"><img src="@item.PreviewUrl" alt="" loading="lazy" onerror="this.parentElement.hidden=true" /></span>
                                            }
                                        </a>
                                        <small class="media-source">@entry.Source.Provider / @entry.Source.InstanceName</small>
                                        <span class="media-title" title="@item.Title">@item.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <BookDescription Description="@item.Description" />
                                        }
                                    </li>
                                }
                            </ul>
                            @if (expanded)
                            {
                                <div class="source-actions" aria-label="@($"{TypeLabel(group.Type)} sources")">
                                    @foreach (var source in group.Sources)
                                    {
                                        @if (source.SearchUrl is not null)
                                        {
                                            <a class="text-action" href="@source.SearchUrl" target="_blank" rel="noopener noreferrer">Show everything in @source.InstanceName <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /></a>
                                        }
                                        else
                                        {
                                            <button class="text-action" type="button" disabled="@(_openingHydrus is not null)" title="Create and focus the full query in the Hydrus desktop client" @onclick="() => OpenHydrusAsync(source.InstanceId)">@(_openingHydrus == source.InstanceId ? "Opening..." : $"Show everything in {source.InstanceName}") <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /></button>
                                        }
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            }
            @if (_hydrusActionMessage is not null)
            {
                <p role="status" class="notice">@_hydrusActionMessage</p>
            }
        </section>
    </main>
    <footer><span>PERSONAL SERVER MANAGER</span><span>YOUR LIBRARIES</span></footer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<StashInstance> _instances = [];
    private IReadOnlyList<HydrusInstance> _hydrusInstances = [];
    private IReadOnlyList<LocalLibraryInstance> _localLibraries = [];
    private IReadOnlyList<LibraryGroup> _groups = [];
    private IReadOnlyList<LibraryGroup>? _expandedGroups;
    private IReadOnlyList<LibraryTypeGroup> _typeGroups = [];
    private readonly HashSet<LibraryMediaType> _expandedTypes = [];
    private LibraryMediaType? _expandingType;
    private string _query = string.Empty;
    private string _submittedQuery = string.Empty;
    private string? _pageError;
    private string? _hydrusActionMessage;
    private Guid? _openingHydrus;
    private bool _configurationLoaded;
    private bool _searchHasRun;
    private bool _isSearching;

    private int VisibleResultCount => _typeGroups.Sum(group => Math.Min(group.Items.Count, _expandedTypes.Contains(group.Type) ? 25 : 5));

    private static string TypeLabel(LibraryMediaType type) => type == LibraryMediaType.TextEbook ? "Text/Ebook" : type.ToString();

    private static string TypeIcon(LibraryMediaType type) => type switch
    {
        LibraryMediaType.Video => Icons.Material.Outlined.Movie,
        LibraryMediaType.Performer => Icons.Material.Outlined.Person,
        LibraryMediaType.Collection => Icons.Material.Outlined.Collections,
        LibraryMediaType.TextEbook => Icons.Material.Outlined.MenuBook,
        LibraryMediaType.Comic => Icons.Material.Outlined.AutoStories,
        LibraryMediaType.Studio => Icons.Material.Outlined.Business,
        LibraryMediaType.Tag => Icons.Material.Outlined.Label,
        LibraryMediaType.Marker => Icons.Material.Outlined.Bookmark,
        LibraryMediaType.Note => Icons.Material.Outlined.Description,
        _ => Icons.Material.Outlined.Image
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _instances = await InstanceStore.GetAllAsync(_lifetime.Token);
            _hydrusInstances = await HydrusStore.GetAllAsync(_lifetime.Token);
            _localLibraries = await LocalStore.GetAllAsync(_lifetime.Token);
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UriFormatException or System.Security.Cryptography.CryptographicException or UnauthorizedAccessException)
        {
            _pageError = "Backend configuration could not be loaded. Check the data directory and Windows account; existing data was not changed.";
        }
        _configurationLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_configurationLoaded && !string.IsNullOrWhiteSpace(Query) && Query.Length <= 1024 && Query.Trim() != _submittedQuery)
        {
            _query = Query;
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (_isSearching || _expandingType is not null || _openingHydrus is not null || string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        _isSearching = true;
        _searchHasRun = true;
        _groups = [];
        _expandedGroups = null;
        _typeGroups = [];
        _expandedTypes.Clear();
        _hydrusActionMessage = null;
        _submittedQuery = _query.Trim();
        try
        {
            _groups = await LibrarySearch.SearchAsync(_instances, _hydrusInstances, _submittedQuery, _lifetime.Token, localLibraries: _localLibraries);
            _typeGroups = LibrarySearchService.GroupByType(_groups);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task ToggleExpandedAsync(LibraryMediaType type)
    {
        if (_isSearching || _expandingType is not null || _openingHydrus is not null)
        {
            return;
        }
        if (_expandedTypes.Remove(type))
        {
            return;
        }

        _expandingType = type;
        try
        {
            if (_expandedGroups is null)
            {
                var groups = await LibrarySearch.SearchAsync(_instances, _hydrusInstances, _submittedQuery, _lifetime.Token, limit: 25, localLibraries: _localLibraries);
                _expandedGroups = groups.Select(group => group.Error is null ? group : group with
                {
                    Items = _groups.FirstOrDefault(original => original.InstanceId == group.InstanceId && original.Category == group.Category)?.Items ?? []
                }).ToArray();
                _typeGroups = LibrarySearchService.GroupByType(_expandedGroups);
            }
            _expandedTypes.Add(type);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _expandingType = null;
        }
    }

    private async Task OpenHydrusAsync(Guid instanceId)
    {
        if (_openingHydrus is not null || _isSearching || _expandingType is not null)
        {
            return;
        }

        var instance = _hydrusInstances.FirstOrDefault(instance => instance.Id == instanceId);
        if (instance is null)
        {
            return;
        }

        _openingHydrus = instanceId;
        try
        {
            await HydrusClient.OpenSearchAsync(instance, LibrarySearchService.ParseHydrusTags(_submittedQuery), _lifetime.Token);
            _hydrusActionMessage = $"Opened the full query in {instance.Name}'s Hydrus desktop client.";
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidDataException or JsonException or ArgumentException)
        {
            _hydrusActionMessage = "Could not open the Hydrus search page. Check connectivity and the access key's manage-pages permission.";
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _openingHydrus = null;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}