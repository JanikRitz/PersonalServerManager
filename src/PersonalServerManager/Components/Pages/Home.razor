@page "/"
@using System.Text.Json
@using PersonalServerManager.Stash
@implements IDisposable
@inject IStashInstanceStore InstanceStore
@inject IStashGraphQlClient StashClient
@inject IJSRuntime JavaScript

<PageTitle>Stash index | Personal Server Manager</PageTitle>

<div class="workspace">
    <header class="topbar">
        <a class="wordmark" href="/" aria-label="Personal Server Manager home"><span class="mark">P</span><span>PERSONAL SERVER<br />MANAGER</span></a>
        <div class="topbar-right"><span class="local-label"><span class="local-dot"></span>LOCAL WORKSPACE</span>
            <form method="post" action="/account/logout"><AntiforgeryToken /><button class="logout" type="submit">Sign out</button></form>
        </div>
    </header>

    <main>
        <div class="page-heading">
            <div><p class="eyebrow">LIBRARY / STASH</p><h1>Stash index</h1></div>
            <div class="heading-meta"><span class="instance-count">@_instances.Count.ToString("00") <span>INSTANCES</span></span>
                <span class="last-refresh">@(_lastRefresh is null ? "Awaiting first check" : $"Checked {_lastRefresh.Value.ToLocalTime():HH:mm:ss}")</span></div>
        </div>
        @if (_pageError is not null)
        {
            <div class="notice error-notice" role="alert">@_pageError</div>
        }

        <div class="dashboard-grid">
            <aside class="inventory-pane" aria-label="Stash instances">
                <div class="section-heading"><div><span class="section-index">01</span><h2>Instances</h2></div><button class="icon-action" type="button" title="Add instance" aria-label="Add instance" @onclick="StartNewInstance">+</button></div>
                @if (_instances.Count == 0)
                {
                    <div class="empty-inventory"><span class="empty-symbol">/</span><p>No Stash instances yet.</p><button class="text-action" type="button" @onclick="StartNewInstance">Add the first instance <span aria-hidden="true">↗</span></button></div>
                }
                else
                {
                    <ul class="instance-list">
                        @foreach (var instance in _instances)
                        {
                            var status = _observations.GetValueOrDefault(instance.Id);
                            <li><button class="instance-row @(instance.Id == _selectedInstanceId ? "selected" : string.Empty)" @onclick="() => SelectInstance(instance.Id)">
                                <span class="status-indicator @(status is null ? "unknown" : status.IsReachable ? "online" : "offline")" aria-hidden="true"></span>
                                <span class="instance-copy"><strong>@instance.Name</strong><small>@instance.GraphQlEndpoint.Host</small></span><span class="row-chevron" aria-hidden="true">›</span>
                            </button></li>
                        }
                    </ul>
                }
                <div class="inventory-footer"><span class="legend-dot online"></span> Connected <span class="legend-dot offline"></span> Unavailable</div>
            </aside>

            <section class="main-pane" aria-label="Search and instance details">
                <section class="search-section">
                    <div class="section-heading"><div><span class="section-index">02</span><h2>Search library</h2></div><span class="read-only-label">READ ONLY</span></div>
                    <form class="search-form" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                        <label class="visually-hidden" for="search-query">Search all configured Stash instances</label>
                        <span class="search-glyph" aria-hidden="true">⌕</span>
                        <input id="search-query" type="search" @bind="_query" @bind:event="oninput" placeholder="Search across every instance" autocomplete="off" />
                        <button class="search-button" type="submit" disabled="@(_isSearching || string.IsNullOrWhiteSpace(_query))">@(_isSearching ? "Searching…" : "Search") <span aria-hidden="true">↗</span></button>
                    </form>
                    <div class="search-controls">
                        <div class="segmented" role="group" aria-label="Search type">
                            @foreach (var kind in Enum.GetValues<StashSearchKind>())
                            {
                                <button class="segment @(_searchKind == kind ? "active" : string.Empty)" type="button" aria-pressed="@(_searchKind == kind)" @onclick="() => SetSearchKind(kind)">@kind</button>
                            }
                        </div>
                        <span class="search-scope">@_instances.Count sources · up to 40 results each</span>
                    </div>
                    @if (_searchHasRun)
                    {
                        <div class="results-header"><h3>Results <span>@_results.Count</span></h3><span>@(_results.Count == 0 && _searchErrors.Count == 0 ? "No matches found" : $"for ‘{_query}’")</span></div>
                        @foreach (var error in _searchErrors)
                        {
                            <div class="instance-error" role="status"><strong>@error.Name</strong><span>@error.Message</span></div>
                        }
                        @if (_results.Count > 0)
                        {
                            <div class="results-table" role="list" aria-label="Search results">
                                @foreach (var result in _results)
                                {
                                    <a class="result-row" href="@result.ItemUrl" target="_blank" rel="noopener noreferrer" role="listitem">
                                        <span class="result-type">@ResultTypeLabel(result.Kind)</span><span class="result-title">@result.Title <small>#@result.Id</small></span>
                                        <span class="result-source">@result.InstanceName <span aria-hidden="true">↗</span></span>
                                    </a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="search-placeholder"><span class="placeholder-line"></span><span>Choose a category and search your connected libraries.</span></div>
                    }
                </section>

                <section class="details-section">
                    <div class="section-heading"><div><span class="section-index">03</span><h2>Instance details</h2></div><button class="text-action" type="button" @onclick="StartNewInstance">+ Add instance</button></div>
                    @if (_selectedInstance is not null)
                    {
                        var observation = _observations.GetValueOrDefault(_selectedInstance.Id);
                        <div class="detail-strip">
                            <div class="detail-name"><span class="status-indicator @(observation is null ? "unknown" : observation.IsReachable ? "online" : "offline")"></span><div><h3>@_selectedInstance.Name</h3><span>@_selectedInstance.GraphQlEndpoint.AbsoluteUri</span></div></div>
                            <div class="detail-status"><small>OBSERVATION</small><strong class="@(observation is null ? "state-unknown" : observation.IsReachable ? "state-online" : "state-offline")">@(observation is null ? "Checking" : observation.IsReachable ? "Available" : "Unavailable")</strong><span>@(observation?.Message ?? "First check pending")</span></div>
                            <div class="detail-actions"><a class="outline-action" href="@_selectedInstance.WebUiUrl" target="_blank" rel="noopener noreferrer">Open Stash <span aria-hidden="true">↗</span></a>
                                <button class="plain-action" type="button" @onclick="() => EditInstance(_selectedInstance)">Edit</button><button class="plain-action danger-action" type="button" @onclick="() => RemoveInstanceAsync(_selectedInstance)">Remove</button></div>
                        </div>
                    }
                    else
                    {
                        <p class="no-selection">Add an instance to begin searching.</p>
                    }
                </section>
            </section>
        </div>

        @if (_isEditing)
        {
            <div class="editor-backdrop" role="presentation" @onclick="CancelEdit">
                <section class="editor-panel" role="dialog" aria-modal="true" aria-labelledby="editor-title" @onclick:stopPropagation="true">
                    <div class="editor-heading"><div><p class="eyebrow">INSTANCE CONFIGURATION</p><h2 id="editor-title">@(_editingId is null ? "Connect Stash" : "Edit instance")</h2></div><button class="icon-action close-action" aria-label="Close" type="button" @onclick="CancelEdit">×</button></div>
                    @if (_editorError is not null)
                    {
                        <div class="notice error-notice" role="alert">@_editorError</div>
                    }
                    <form class="editor-form" @onsubmit="SaveInstanceAsync" @onsubmit:preventDefault="true">
                        <label>Instance name<input @bind="_draftName" maxlength="60" required placeholder="e.g. Main library" /></label>
                        <label>GraphQL endpoint<input @bind="_draftGraphQlUrl" type="url" required placeholder="http://localhost:9999/graphql" /></label>
                        <label>Stash interface URL<input @bind="_draftWebUrl" type="url" required placeholder="http://localhost:9999/" /></label>
                        <label>API key <span class="field-note">@(_editingId is null ? "Optional" : "Leave blank to keep the current key")</span><input @bind="_draftApiKey" type="password" autocomplete="new-password" /></label>
                        <p class="security-note">API keys are encrypted on this Windows account. Use HTTPS for Stash endpoints that cross an untrusted network.</p>
                        <div class="editor-actions"><button class="cancel-button" type="button" @onclick="CancelEdit">Cancel</button><button class="save-button" type="submit" disabled="@_isSaving">@(_isSaving ? "Saving…" : "Save instance")</button></div>
                    </form>
                </section>
            </div>
        }
    </main>
    <footer><span>PERSONAL SERVER MANAGER</span><span>STASH CONNECTOR · OBSERVATION ONLY</span></footer>
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly Dictionary<Guid, StashObservation> _observations = [];
    private readonly List<(string Name, string Message)> _searchErrors = [];
    private IReadOnlyList<StashInstance> _instances = [];
    private IReadOnlyList<StashSearchResult> _results = [];
    private Guid? _selectedInstanceId;
    private DateTimeOffset? _lastRefresh;
    private string _query = string.Empty;
    private string _draftName = string.Empty;
    private string _draftGraphQlUrl = string.Empty;
    private string _draftWebUrl = string.Empty;
    private string _draftApiKey = string.Empty;
    private string? _pageError;
    private string? _editorError;
    private Guid? _editingId;
    private StashSearchKind _searchKind = StashSearchKind.Scenes;
    private bool _searchHasRun;
    private bool _isSearching;
    private bool _isEditing;
    private bool _isSaving;

    private StashInstance? _selectedInstance => _instances.FirstOrDefault(instance => instance.Id == _selectedInstanceId);

    protected override async Task OnInitializedAsync()
    {
        await LoadInstancesAsync();
        await RefreshObservationsAsync();
        _ = ObservePeriodicallyAsync(_lifetime.Token);
    }

    private async Task LoadInstancesAsync()
    {
        try
        {
            _instances = await InstanceStore.GetAllAsync(_lifetime.Token);
            if (_selectedInstanceId is null || _instances.All(instance => instance.Id != _selectedInstanceId))
            {
                _selectedInstanceId = _instances.FirstOrDefault()?.Id;
            }
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UriFormatException)
        {
            _pageError = exception.Message;
        }
    }

    private async Task RefreshObservationsAsync()
    {
        var tasks = _instances.Select(async instance =>
        {
            try
            {
                return await StashClient.ObserveAsync(instance, _lifetime.Token);
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
            {
                throw;
            }
            catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException or JsonException)
            {
                return new StashObservation(instance.Id, instance.Name, false, DateTimeOffset.UtcNow, SafeError(exception));
            }
        });
        foreach (var observation in await Task.WhenAll(tasks))
        {
            _observations[observation.InstanceId] = observation;
        }

        _lastRefresh = DateTimeOffset.UtcNow;
    }

    private async Task ObservePeriodicallyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshObservationsAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task SearchAsync()
    {
        if (_isSearching || string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        _isSearching = true;
        _searchHasRun = true;
        _results = [];
        _searchErrors.Clear();
        try
        {
            var searches = await Task.WhenAll(_instances.Select(async instance =>
            {
                try
                {
                    var results = await StashClient.SearchAsync(instance, _searchKind, _query.Trim(), _lifetime.Token);
                    return (Instance: instance, Results: results, Error: (string?)null);
                }
                catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException or JsonException or UriFormatException)
                {
                    return (Instance: instance, Results: (IReadOnlyList<StashSearchResult>)[], Error: SafeError(exception));
                }
            }));

            _results = searches.SelectMany(search => search.Results).ToArray();
            _searchErrors.AddRange(searches.Where(search => search.Error is not null).Select(search => (search.Instance.Name, search.Error!)));
        }
        finally
        {
            _isSearching = false;
        }
    }

    private void StartNewInstance()
    {
        _editingId = null;
        _draftName = string.Empty;
        _draftGraphQlUrl = "http://localhost:9999/graphql";
        _draftWebUrl = "http://localhost:9999/";
        _draftApiKey = string.Empty;
        _editorError = null;
        _isEditing = true;
    }

    private void EditInstance(StashInstance instance)
    {
        _editingId = instance.Id;
        _draftName = instance.Name;
        _draftGraphQlUrl = instance.GraphQlEndpoint.AbsoluteUri;
        _draftWebUrl = instance.WebUiUrl.AbsoluteUri;
        _draftApiKey = string.Empty;
        _editorError = null;
        _isEditing = true;
    }

    private async Task SaveInstanceAsync()
    {
        if (_isSaving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_draftName) || _draftName.Trim().Length > 60 ||
            !TryParseEndpoint(_draftGraphQlUrl, out var graphQlUrl) || !TryParseEndpoint(_draftWebUrl, out var webUrl))
        {
            _editorError = "Enter a name (up to 60 characters) and valid HTTP or HTTPS URLs without embedded credentials.";
            return;
        }

        _isSaving = true;
        try
        {
            var instance = new StashInstance(_editingId ?? Guid.NewGuid(), _draftName.Trim(), graphQlUrl!, webUrl!, _draftApiKey);
            await InstanceStore.SaveAsync(instance, _lifetime.Token);
            await LoadInstancesAsync();
            _selectedInstanceId = instance.Id;
            _isEditing = false;
            _pageError = null;
            await RefreshObservationsAsync();
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UnauthorizedAccessException)
        {
            _editorError = $"Configuration was not saved: {exception.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RemoveInstanceAsync(StashInstance instance)
    {
        if (!await JavaScript.InvokeAsync<bool>("confirm", $"Remove {instance.Name} from this manager? The Stash instance will not be changed."))
        {
            return;
        }

        try
        {
            await InstanceStore.RemoveAsync(instance.Id, _lifetime.Token);
            _observations.Remove(instance.Id);
            await LoadInstancesAsync();
            _searchHasRun = false;
            _pageError = null;
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UnauthorizedAccessException)
        {
            _pageError = $"Configuration was not removed: {exception.Message}";
        }
    }

    private void SelectInstance(Guid id) => _selectedInstanceId = id;

    private async Task SetSearchKind(StashSearchKind kind)
    {
        _searchKind = kind;
        if (_searchHasRun)
        {
            await SearchAsync();
        }
    }

    private void CancelEdit()
    {
        _isEditing = false;
        _editorError = null;
    }

    private static bool TryParseEndpoint(string value, out Uri? uri) =>
        Uri.TryCreate(value.Trim(), UriKind.Absolute, out uri) &&
        (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps) &&
        string.IsNullOrEmpty(uri.UserInfo) &&
        string.IsNullOrEmpty(uri.Fragment);

    private static string ResultTypeLabel(StashSearchKind kind) => kind switch
    {
        StashSearchKind.Scenes => "SCENE",
        StashSearchKind.Images => "IMAGE",
        _ => "PERFORMER"
    };

    private static string SafeError(Exception exception) => exception switch
    {
        TaskCanceledException => "Request timed out.",
        HttpRequestException => exception.Message,
        InvalidDataException => exception.Message,
        _ => "Stash returned an invalid response."
    };

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
