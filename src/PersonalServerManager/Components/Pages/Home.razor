@page "/"
@using System.Text.Json
@using PersonalServerManager.Stash
@using PersonalServerManager.Hydrus
@using PersonalServerManager.Search
@using PersonalServerManager.LocalLibraries
@using PersonalServerManager.Management
@using PersonalServerManager.RandomPlot
@using PersonalServerManager.SwarmUI
@implements IDisposable
@inject IStashInstanceStore InstanceStore
@inject IHydrusInstanceStore HydrusStore
@inject IHydrusClient HydrusClient
@inject LibrarySearchService LibrarySearch
@inject ComicCompanionService ComicCompanion
@inject ILocalLibraryStore LocalStore
@inject ISwarmUIInstanceStore SwarmStore
@inject IRandomPlotInstanceStore RandomPlotStore

<PageTitle>Library search | Personal Server Manager</PageTitle>

<div class="workspace @(_searchHasRun ? "has-results" : string.Empty)">
    <header class="topbar">
        <a class="wordmark" href="/" aria-label="Personal Server Manager home"><span class="mark">P</span><span>Personal Server Manager</span></a>
        <nav class="topbar-right" aria-label="Workspace">
            <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Toggle dark mode"><span class="theme-moon"><MudIcon Icon="@Icons.Material.Outlined.DarkMode" /></span><span class="theme-sun"><MudIcon Icon="@Icons.Material.Outlined.LightMode" /></span></button>
            <a class="icon-action" href="/feeds" aria-label="Feeds" title="Feeds"><MudIcon Icon="@Icons.Material.Outlined.Collections" /></a>
            <a class="icon-action" href="/covers" aria-label="Cover studio" title="Cover studio"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /></a>
            <a class="icon-action" href="/backends" aria-label="Manage backends" title="Manage backends"><MudIcon Icon="@Icons.Material.Outlined.Settings" /></a>
            <form method="post" action="/account/logout"><AntiforgeryToken /><button class="logout" type="submit">Sign out</button></form>
        </nav>
    </header>

    <main>
        <section class="search-section" aria-label="Library search">
            @if (_pageError is not null)
            {
                <div class="notice error-notice" role="alert">@_pageError</div>
            }
            <form class="search-form" role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <label class="visually-hidden" for="search-query">Search all libraries</label>
                <span class="search-glyph" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Search" /></span>
                <input id="search-query" type="search" @bind="_query" @bind:event="oninput" maxlength="1024" placeholder="Search all libraries" autocomplete="off" />
                <button class="search-button" type="submit" title="Search" aria-label="@(_isSearching ? "Searching" : "Search")" disabled="@(_isSearching || _isSorting || _expandingType is not null || _openingHydrus is not null || string.IsNullOrWhiteSpace(_query))"><MudIcon Icon="@(_isSearching ? Icons.Material.Outlined.HourglassEmpty : Icons.Material.Outlined.ArrowForward)" /></button>
            </form>
            @if (_configurationLoaded && _comicCompanionCount + _instances.Count + _hydrusInstances.Count + _localLibraries.Count + _swarmInstances.Count + _randomPlotInstances.Count == 0 && _pageError is null)
            {
                <p class="empty-state">No backends connected. <a href="/backends">Add a backend</a></p>
            }
            @if (_searchHasRun)
            {
                @if (_isSearching)
                {
                    <div class="search-loading" role="status" aria-live="polite">
                        <span class="loading-spinner" aria-hidden="true"></span>
                        <div><h2>Searching your libraries</h2><p>Fetching results for '@_submittedQuery'</p></div>
                    </div>
                    <progress class="search-progress" aria-label="Fetching search results"></progress>
                    <div class="loading-grid" aria-hidden="true">
                        @for (var index = 0; index < 5; index++)
                        {
                            <div class="loading-tile"><span class="loading-thumbnail"></span><span class="loading-line"></span><span class="loading-line short"></span></div>
                        }
                    </div>
                }
                else
                {
                    <div class="results-header">
                        <div role="status" aria-live="polite"><h2>Results <span>@VisibleResultCount</span></h2><span>for '@_submittedQuery'</span></div>
                        @if (_typeGroups.Count > 0)
                        {
                            <div class="sort-controls">
                                <label for="result-sort">Sort results</label>
                                <select id="result-sort" @bind="_sort" @bind:after="ChangeSortAsync" disabled="@(_expandingType is not null || _isSorting)">
                                    <option value="@LibrarySort.Default">Default</option>
                                    <option value="@LibrarySort.TitleAscending">A-Z</option>
                                    <option value="@LibrarySort.TitleDescending">Z-A</option>
                                    <option value="@LibrarySort.DateNewest">Date newest</option>
                                    <option value="@LibrarySort.DateOldest">Date oldest</option>
                                    <option value="@LibrarySort.Random">Random</option>
                                </select>
                                @if (_sort == LibrarySort.Random)
                                {
                                    <button type="button" class="shuffle-action" title="Shuffle again" aria-label="Shuffle again" disabled="@(_expandingType is not null || _isSorting)" @onclick="ChangeSortAsync"><MudIcon Icon="@Icons.Material.Outlined.Shuffle" Size="Size.Small" /></button>
                                }
                            </div>
                        }
                    </div>
                    @if (_isSorting)
                    {
                        <div class="expansion-loading" role="status"><span class="loading-spinner" aria-hidden="true"></span><span>Fetching sorted results...</span></div>
                        <progress class="search-progress" aria-label="Fetching sorted results"></progress>
                    }
                }
                @foreach (var failure in (_expandedGroups ?? _groups).Where(group => group.Error is not null))
                {
                    var source = failure.BackendUnreachable
                        ? $"{failure.Provider} / {failure.InstanceName}"
                        : $"{failure.InstanceName} / {failure.Category}";
                    <p class="instance-error" role="status">@source: @failure.Error</p>
                }
                @if (!_isSearching && _typeGroups.Count == 0)
                {
                    <p class="empty-state">@(_groups.Any(group => group.Error is not null) ? "No results available from the remaining backends." : "No results found.")</p>
                }
                <div class="results" aria-busy="@(_isSearching || _isSorting || _expandingType is not null ? "true" : "false")">
                    @foreach (var group in _typeGroups)
                    {
                        var expanded = _expandedTypes.Contains(group.Type);
                        var resultsId = $"results-{group.Type}";
                        <section class="result-group" aria-label="@TypeLabel(group.Type)" @key="group.Type">
                            <div class="group-heading">
                                <h3>@TypeLabel(group.Type)</h3>
                                <button class="text-action expand-action" type="button" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@resultsId" disabled="@(_expandingType is not null || _isSorting || _openingHydrus is not null)" @onclick="() => ToggleExpandedAsync(group.Type)">
                                    @(_expandingType == group.Type ? "Loading..." : expanded ? "Show less" : "Show up to 25")
                                    <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                                </button>
                            </div>
                            @if (_expandingType == group.Type)
                            {
                                <div class="expansion-loading" role="status"><span class="loading-spinner" aria-hidden="true"></span><span>Fetching more @TypeLabel(group.Type) results...</span></div>
                                <progress class="search-progress" aria-label="@($"Fetching more {TypeLabel(group.Type)} results")"></progress>
                            }
                            <ul class="media-grid" id="@resultsId">
                                @foreach (var entry in group.Items.Take(expanded ? 25 : 5))
                                {
                                    var item = entry.Item;
                                    var sourceLabel = SourceLabel(entry.Source);
                                    var badgeId = $"{resultsId}-{entry.Source.InstanceId:N}-{entry.Source.Category}-{Uri.EscapeDataString(item.Id)}";
                                    var descriptions = item.FileFormat is null ? $"{badgeId}-source" : $"{badgeId}-source {badgeId}-format";
                                    var score = item.RatingOutOfFive?.ToString("0.##");
                                    var ratingLabel = score is not null ? $"Rated {score} out of 5" : item.IsFavorite ? "Favorite" : null;
                                    if (ratingLabel is not null) descriptions += $" {badgeId}-rating";
                                    var contentBadgeText = item.ContentCount is { } count
                                        ? count.ToString()
                                        : group.Type == LibraryMediaType.Comic && item.FileSizeBytes is { } size
                                            ? FormatFileSize(size) : null;
                                    var contentBadgeLabel = item.ContentCount is { } contentCount
                                        ? $"{contentCount} {(group.Type == LibraryMediaType.Comic ? "pages" : "items")}" :
                                        group.Type == LibraryMediaType.Comic && item.FileSizeBytes is { } fileSize
                                            ? $"File size: {fileSize:N0} bytes" : null;
                                    if (contentBadgeLabel is not null) descriptions += $" {badgeId}-count";
                                    var durationBadgeLabel = item.Duration is { } duration &&
                                        group.Type is LibraryMediaType.Video or LibraryMediaType.Image
                                            ? $"Duration: {FormatDuration(duration)}" : null;
                                    var durationBadgeText = durationBadgeLabel is not null ? FormatDuration(item.Duration!.Value) : null;
                                    if (group.Type == LibraryMediaType.Marker && item.MarkerStart is { } markerStart)
                                    {
                                        durationBadgeText = FormatDuration(markerStart);
                                        durationBadgeLabel = $"Start: {durationBadgeText}";
                                        if (item.MarkerEnd is { } markerEnd)
                                        {
                                            var endText = FormatDuration(markerEnd);
                                            durationBadgeText += $" - {endText}";
                                            durationBadgeLabel += $", end: {endText}";
                                        }
                                    }
                                    if (durationBadgeLabel is not null) descriptions += $" {badgeId}-duration";
                                    <li class="media-tile" @key="(entry.Source.InstanceId, entry.Source.Category, item.Id)">
                                        <a class="thumbnail-link" href="@(item.ReaderUrl ?? item.ItemUrl ?? item.PreviewUrl)" target="_blank" rel="noopener noreferrer" aria-label="@(item.ReaderUrl is not null ? $"Read {item.Title}" : item.ItemUrl is null ? $"View preview: {item.Title}" : $"Open {item.Title} in {entry.Source.InstanceName}")" aria-describedby="@descriptions">
                                            <span class="thumbnail-placeholder" aria-hidden="true"><MudIcon Icon="@TypeIcon(group.Type)" /></span>
                                            @if (item.PreviewUrl is not null)
                                            {
                                                <img class="thumbnail" src="@item.PreviewUrl" alt="" loading="lazy" onerror="this.hidden=true" />
                                                @if (item.AnimatedPreviewUrl is not null)
                                                {
                                                    @if (item.AnimatedPreviewIsVideo)
                                                    {
                                                        <video class="thumbnail" src="@item.AnimatedPreviewUrl" autoplay muted loop playsinline preload="metadata" aria-hidden="true" onerror="this.hidden=true"></video>
                                                    }
                                                    else
                                                    {
                                                        <img class="thumbnail" src="@item.AnimatedPreviewUrl" alt="" loading="lazy" onerror="this.hidden=true" />
                                                    }
                                                }
                                                <span class="thumbnail-zoom" aria-hidden="true">
                                                    <img src="@item.PreviewUrl" alt="" loading="lazy" onerror="this.parentElement.hidden=true" />
                                                    @if (item.AnimatedPreviewUrl is not null)
                                                    {
                                                        @if (item.AnimatedPreviewIsVideo)
                                                        {
                                                            <video class="zoom-animation" src="@item.AnimatedPreviewUrl" autoplay muted loop playsinline preload="metadata" onerror="this.hidden=true"></video>
                                                        }
                                                        else
                                                        {
                                                            <img class="zoom-animation" src="@item.AnimatedPreviewUrl" alt="" loading="lazy" onerror="this.hidden=true" />
                                                        }
                                                    }
                                                </span>
                                            }
                                            @if (item.FileFormat is not null)
                                            {
                                                <span class="format-badge" id="@($"{badgeId}-format")">@item.FileFormat</span>
                                            }
                                            <span class="bottom-badges">
                                                <span class="source-badge" id="@($"{badgeId}-source")" title="@sourceLabel">@sourceLabel</span>
                                                @if (contentBadgeText is not null)
                                                {
                                                    <span class="content-count-badge" id="@($"{badgeId}-count")" aria-label="@contentBadgeLabel" title="@contentBadgeLabel">@contentBadgeText</span>
                                                }
                                                @if (durationBadgeLabel is not null)
                                                {
                                                    <span class="duration-badge" id="@($"{badgeId}-duration")" aria-label="@durationBadgeLabel" title="@durationBadgeLabel">@durationBadgeText</span>
                                                }
                                            </span>
                                            @if (ratingLabel is not null)
                                            {
                                                <span class="rating-badge" id="@($"{badgeId}-rating")" title="@ratingLabel">
                                                    <span class="visually-hidden">@ratingLabel</span>
                                                    <span aria-hidden="true">&#9733;@(score is null ? null : $" {score}/5")</span>
                                                </span>
                                            }
                                        </a>
                                        <span class="media-title" title="@item.Title">@item.Title</span>
                                        @if (item.ReaderUrl is not null && item.ItemUrl is not null)
                                        {
                                            <a href="@item.ItemUrl" download aria-label="@($"Download {item.Title}")"><MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" /></a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <BookDescription Description="@item.Description" />
                                        }
                                    </li>
                                }
                            </ul>
                            @if (expanded)
                            {
                                <div class="source-actions" aria-label="@($"{TypeLabel(group.Type)} sources")">
                                    @foreach (var source in group.Sources)
                                    {
                                        @if (source.SearchUrl is not null)
                                        {
                                            <a class="text-action" href="@source.SearchUrl" target="_blank" rel="noopener noreferrer">Show everything in @source.InstanceName <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /></a>
                                        }
                                        else if (source.Provider == "Hydrus")
                                        {
                                            <button class="text-action" type="button" disabled="@(_openingHydrus is not null)" title="Create and focus the full query in the Hydrus desktop client" @onclick="() => OpenHydrusAsync(source.InstanceId)">@(_openingHydrus == source.InstanceId ? "Opening..." : $"Show everything in {source.InstanceName}") <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /></button>
                                        }
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            }
            @if (_hydrusActionMessage is not null)
            {
                <p role="status" class="notice">@_hydrusActionMessage</p>
            }
        </section>
    </main>
    <footer><span>PERSONAL SERVER MANAGER</span><span>YOUR LIBRARIES</span></footer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<StashInstance> _instances = [];
    private IReadOnlyList<HydrusInstance> _hydrusInstances = [];
    private IReadOnlyList<LocalLibraryInstance> _localLibraries = [];
    private IReadOnlyList<SwarmUIInstance> _swarmInstances = [];
    private IReadOnlyList<RandomPlotInstance> _randomPlotInstances = [];
    private IReadOnlyList<LibraryGroup> _groups = [];
    private IReadOnlyList<LibraryGroup>? _expandedGroups;
    private IReadOnlyList<LibraryTypeGroup> _typeGroups = [];
    private LibrarySort _sort;
    private readonly HashSet<LibraryMediaType> _expandedTypes = [];
    private LibraryMediaType? _expandingType;
    private string _query = string.Empty;
    private string _submittedQuery = string.Empty;
    private string? _pageError;
    private string? _hydrusActionMessage;
    private Guid? _openingHydrus;
    private bool _configurationLoaded;
    private bool _searchHasRun;
    private bool _isSearching;
    private bool _isSorting;

    private int VisibleResultCount => _typeGroups.Sum(group => Math.Min(group.Items.Count, _expandedTypes.Contains(group.Type) ? 25 : 5));

    private static string TypeLabel(LibraryMediaType type) => type switch
    {
        LibraryMediaType.TextEbook => "Text/Ebook",
        LibraryMediaType.RandomPlotGroup => "Random Plot Generator",
        _ => type.ToString()
    };

    private static string FormatFileSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var size = (double)bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.#} {units[unit]}";
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalSeconds < 1)
            return $"{duration.TotalSeconds:0.#}s";

        var rounded = TimeSpan.FromSeconds(Math.Round(duration.TotalSeconds));
        return rounded.TotalHours >= 1
            ? $"{(int)rounded.TotalHours}:{rounded.Minutes:00}:{rounded.Seconds:00}"
            : $"{(int)rounded.TotalMinutes}:{rounded.Seconds:00}";
    }

    private static string TypeIcon(LibraryMediaType type) => type switch
    {
        LibraryMediaType.Video => Icons.Material.Outlined.Movie,
        LibraryMediaType.Performer => Icons.Material.Outlined.Person,
        LibraryMediaType.Collection => Icons.Material.Outlined.Collections,
        LibraryMediaType.TextEbook => Icons.Material.Outlined.MenuBook,
        LibraryMediaType.Comic => Icons.Material.Outlined.AutoStories,
        LibraryMediaType.Studio => Icons.Material.Outlined.Business,
        LibraryMediaType.Tag => Icons.Material.Outlined.Label,
        LibraryMediaType.Marker => Icons.Material.Outlined.Bookmark,
        LibraryMediaType.Note => Icons.Material.Outlined.Description,
        LibraryMediaType.RandomPlotGroup => Icons.Material.Outlined.Casino,
        _ => Icons.Material.Outlined.Image
    };

    private int _comicCompanionCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _instances = await InstanceStore.GetAllAsync(_lifetime.Token);
            _hydrusInstances = await HydrusStore.GetAllAsync(_lifetime.Token);
            _localLibraries = await LocalStore.GetAllAsync(_lifetime.Token);
            _swarmInstances = await SwarmStore.GetAllAsync(_lifetime.Token);
            _randomPlotInstances = await RandomPlotStore.GetAllAsync(_lifetime.Token);
            _comicCompanionCount = (await ComicCompanion.GetAllAsync(_lifetime.Token)).Count;
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UriFormatException or System.Security.Cryptography.CryptographicException or UnauthorizedAccessException or System.Text.Json.JsonException)
        {
            _pageError = "Backend configuration could not be loaded. Check the data directory and Windows account; existing data was not changed.";
        }
        _configurationLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_configurationLoaded && !string.IsNullOrWhiteSpace(Query) && Query.Length <= 1024 && Query.Trim() != _submittedQuery)
        {
            _query = Query;
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (_isSearching || _isSorting || _expandingType is not null || _openingHydrus is not null || string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        _isSearching = true;
        _searchHasRun = true;
        _groups = [];
        _expandedGroups = null;
        _typeGroups = [];
        _expandedTypes.Clear();
        _hydrusActionMessage = null;
        _submittedQuery = _query.Trim();
        try
        {
            _groups = await LibrarySearch.SearchAsync(_instances, _hydrusInstances, _submittedQuery, _lifetime.Token, localLibraries: _localLibraries, sort: _sort, swarmInstances: _swarmInstances, randomPlotInstances: _randomPlotInstances);
            ApplySort();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task ToggleExpandedAsync(LibraryMediaType type)
    {
        if (_isSearching || _isSorting || _expandingType is not null || _openingHydrus is not null)
        {
            return;
        }
        if (_expandedTypes.Remove(type))
        {
            return;
        }

        _expandingType = type;
        try
        {
            if (_expandedGroups is null)
            {
                _expandedGroups = await RefetchAsync(_groups, 25);
                ApplySort();
            }
            _expandedTypes.Add(type);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _expandingType = null;
        }
    }

    private async Task ChangeSortAsync()
    {
        if (_isSearching || _isSorting || _expandingType is not null || _openingHydrus is not null)
        {
            return;
        }

        _isSorting = true;
        try
        {
            if (_expandedGroups is null)
            {
                _groups = await RefetchAsync(_groups, 5);
            }
            else
            {
                _expandedGroups = await RefetchAsync(_expandedGroups, 25);
            }
            ApplySort();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _isSorting = false;
        }
    }

    private async Task<IReadOnlyList<LibraryGroup>> RefetchAsync(IReadOnlyList<LibraryGroup> current, int limit)
    {
        var unavailable = current.Where(group => group.BackendUnreachable)
            .Select(group => (group.Provider, group.InstanceId)).ToHashSet();
        var groups = await LibrarySearch.SearchAsync(
            _instances.Where(instance => !unavailable.Contains(("Stash", instance.Id))).ToArray(),
            _hydrusInstances.Where(instance => !unavailable.Contains(("Hydrus", instance.Id))).ToArray(),
            _submittedQuery, _lifetime.Token, limit: limit, localLibraries: _localLibraries, sort: _sort,
            swarmInstances: _swarmInstances.Where(instance => !unavailable.Contains(("SwarmUI", instance.Id))).ToArray(),
            randomPlotInstances: _randomPlotInstances.Where(instance => !unavailable.Contains(("Random Plot Generator", instance.Id))).ToArray());
        var refreshed = groups.ToDictionary(group => (group.Provider, group.InstanceId, group.Category));
        return current.Select(original =>
        {
            if (!refreshed.TryGetValue((original.Provider, original.InstanceId, original.Category), out var group))
            {
                return original;
            }
            return group.Error is null && !group.BackendUnreachable ? group : group with { Items = original.Items };
        }).ToArray();
    }

    private string SourceLabel(LibraryGroup source)
    {
        var instanceCount = source.Provider switch
        {
            "Stash" => _instances.Count,
            "Hydrus" => _hydrusInstances.Count,
            "Calibre" => _localLibraries.Count(instance => instance.IsCalibre),
            "Notes" => _localLibraries.Count(instance => instance.Kind == LocalLibraryKind.Notes),
            "Comic Companion" => _comicCompanionCount,
            "SwarmUI" => _swarmInstances.Count,
            "Random Plot Generator" => _randomPlotInstances.Count,
            _ => 0
        };
        return instanceCount == 1 && string.Equals(source.Provider, source.InstanceName, StringComparison.OrdinalIgnoreCase)
            ? source.Provider : $"{source.Provider} / {source.InstanceName}";
    }

    private void ApplySort()
    {
        _typeGroups = LibrarySearchService.GroupByType(_expandedGroups ?? _groups)
            .Select(group => group with { Items = LibrarySearchService.SortItems(group.Items, _sort) }).ToArray();
    }

    private async Task OpenHydrusAsync(Guid instanceId)
    {
        if (_openingHydrus is not null || _isSearching || _isSorting || _expandingType is not null)
        {
            return;
        }

        var instance = _hydrusInstances.FirstOrDefault(instance => instance.Id == instanceId);
        if (instance is null)
        {
            return;
        }

        _openingHydrus = instanceId;
        try
        {
            await HydrusClient.OpenExpandedSearchAsync(instance, LibrarySearchService.ParseHydrusTags(_submittedQuery), _lifetime.Token);
            _hydrusActionMessage = $"Opened the full query in {instance.Name}'s Hydrus desktop client.";
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidDataException or JsonException or ArgumentException)
        {
            _hydrusActionMessage = "Could not open the Hydrus search page. Check connectivity and the access key's manage-pages permission.";
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _openingHydrus = null;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}