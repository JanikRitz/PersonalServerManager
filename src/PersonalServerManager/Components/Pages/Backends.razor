@page "/backends"
@using System.Text.Json
@using PersonalServerManager.Stash
@using PersonalServerManager.Hydrus
@using PersonalServerManager.LocalLibraries
@using PersonalServerManager.Management
@using PersonalServerManager.SwarmUI
@implements IDisposable
@inject IStashInstanceStore InstanceStore
@inject IStashGraphQlClient StashClient
@inject IHydrusInstanceStore HydrusStore
@inject ILocalLibraryStore LocalStore
@inject ISwarmUIInstanceStore SwarmStore
@inject ManagedBackendService ManagedBackends
@inject IJSRuntime JavaScript

<PageTitle>Server Management | Personal Server Manager</PageTitle>

<div class="workspace">
    <header class="topbar">
        <a class="wordmark" href="/" aria-label="Personal Server Manager home"><span class="mark">P</span><span>Personal Server Manager</span></a>
        <nav class="topbar-right" aria-label="Workspace">
            <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Toggle dark mode"><span class="theme-moon"><MudIcon Icon="@Icons.Material.Outlined.DarkMode" /></span><span class="theme-sun"><MudIcon Icon="@Icons.Material.Outlined.LightMode" /></span></button>
            <a class="nav-link" href="/" aria-label="Library search" title="Library search"><MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" /><span>Search</span></a>
            <a class="nav-link" href="/feeds" aria-label="Feeds" title="Feeds"><MudIcon Icon="@Icons.Material.Outlined.Collections" Size="Size.Small" /><span>Feeds</span></a>
            <form method="post" action="/account/logout"><AntiforgeryToken /><button class="logout" type="submit">Sign out</button></form>
        </nav>
    </header>

    <main>
        <div class="page-heading">
            <h1>Server Management</h1>
            <div class="heading-meta">
                <span class="instance-count">@((_instances.Count + _hydrusInstances.Count + _localLibraries.Count + _swarmInstanceCount + _comicInstanceCount).ToString("00")) <span>INSTANCES</span></span>
            </div>
        </div>
        @if (_pageError is not null)
        {
            <div class="notice error-notice" role="alert">@_pageError</div>
        }
        @if (_hydrusError is not null)
        {
            <div class="notice error-notice" role="alert">@_hydrusError</div>
        }
        @if (_localError is not null)
        {
            <div class="notice error-notice" role="alert">@_localError</div>
        }

        <div class="management-grid">
            <CascadingValue Value="_selection" IsFixed="true">
            <section class="backend-group stash-section" aria-labelledby="stash-heading">
                <div class="section-heading">
                    <h2 id="stash-heading">Stash</h2>
                    <button class="icon-action" type="button" title="Add Stash instance" aria-label="Add Stash instance" disabled="@_isSaving" @onclick="StartNewInstance"><MudIcon Icon="@Icons.Material.Filled.Add" /></button>
                </div>
                @if (_lastRefresh is null && _pageError is null && _instances.Count == 0)
                {
                    <p class="empty-inventory" role="status">Loading Stash instances...</p>
                }
                else if (_instances.Count == 0 && _pageError is null)
                {
                    <div class="empty-inventory"><p>No Stash instances configured.</p><button class="text-action" type="button" @onclick="StartNewInstance"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />Add instance</button></div>
                }
                else
                {
                    <ul class="instance-list" aria-label="Stash instances">
                        @foreach (var instance in _instances)
                        {
                            var observation = _observations.GetValueOrDefault(instance.Id);
                            <li @key="instance.Id">
                                <BackendInstanceRow Name="@instance.Name" Type="@(instance.IsManaged ? "Managed" : "External")" Status="@(observation is null ? "Unknown" : observation.IsReachable ? "Available" : "Unavailable")"
                                                    StatusClass="@(observation is null ? "unknown" : observation.IsReachable ? "online" : "offline")"
                                                    Selected="@_selection.IsSelected("Stash", instance.Id)" OnSelect="() => SelectInstance(instance.Id)">
                                    <Actions>
                                        @if (instance.IsManaged)
                                        {
                                            <ManagedBackendControls InstanceId="@instance.Id" InstanceName="@instance.Name" Compact="true" />
                                        }
                                    </Actions>
                                </BackendInstanceRow>
                            </li>
                        }
                    </ul>
                }

            </section>

            @if (_selectedInstance is not null)
                {
                    var observation = _observations.GetValueOrDefault(_selectedInstance.Id);
                    <section class="backend-details instance-details" aria-labelledby="details-heading">
                        <div class="details-heading"><h3 id="details-heading">@_selectedInstance.Name</h3><span class="state @(observation is null ? "state-unknown" : observation.IsReachable ? "state-online" : "state-offline")">@(observation is null ? "Unknown" : observation.IsReachable ? "Available" : "Unavailable")</span></div>
                        <dl>
                            <dt>GraphQL endpoint</dt><dd>@_selectedInstance.GraphQlEndpoint.AbsoluteUri</dd>
                            <dt>Stash interface</dt><dd>@_selectedInstance.WebUiUrl.AbsoluteUri</dd>
                            <dt>Observation</dt><dd role="status">@(observation?.Message ?? "First check pending")</dd>
                        </dl>
                        @if (_selectedInstance.IsManaged)
                        {
                            <ManagedBackendControls @key="_selectedInstance.Id" InstanceId="@_selectedInstance.Id" StartWithApp="@_selectedInstance.StartWithApp" StartWithAppChanged="SaveStashAutostartAsync" SettingsOnly="true" />
                        }
                        <StashJobs @key="(typeof(StashJobs), _selectedInstance.Id)" Instance="_selectedInstance" SettingsSaved="LoadInstancesAsync" />
                        <div class="detail-actions">
                            <a class="outline-action" href="@_selectedInstance.BrowserUrl(_selectedInstance.WebUiUrl)" target="_blank" rel="noopener noreferrer">Open Stash<MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" /></a>
                            <button class="text-action" type="button" disabled="@_isSaving" @onclick="() => EditInstance(_selectedInstance)"><MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />Edit</button>
                            <button class="text-action danger-action" type="button" disabled="@_isSaving" @onclick="() => RemoveInstanceAsync(_selectedInstance)"><MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />Remove</button>
                        </div>
                    </section>
                }

            <HydrusInstances Changed="ReloadHydrusAsync" />
            <SwarmUIInstances Changed="ReloadSwarmAsync" />
            <LocalLibraries FilterKind="LocalLibraryKind.Calibre" Changed="ReloadLocalAsync" />
            <LocalLibraries FilterKind="LocalLibraryKind.Notes" Changed="ReloadLocalAsync" />
            <ComicCompanionControls CountChanged="count => _comicInstanceCount = count" />
            @if (_selection.Type is null)
            {
                <section class="backend-details empty-details" aria-label="Instance details"><p>Select an instance to view its details.</p></section>
            }
            </CascadingValue>
        </div>
    </main>

    <footer><span>PERSONAL SERVER MANAGER</span><span>LIBRARY CONNECTIONS</span></footer>

    @if (_isEditing)
    {
        <div class="editor-backdrop" role="presentation" @onclick="CancelEdit" @onkeydown="HandleEditorKey">
            <section class="editor-panel" role="dialog" aria-modal="true" aria-labelledby="editor-title" @onclick:stopPropagation="true">
                <MudFocusTrap>
                <div class="editor-heading"><h2 id="editor-title">@(_editingId is null ? "Connect Stash" : "Edit instance")</h2><button class="icon-action" aria-label="Close Stash editor" title="Close Stash editor" type="button" disabled="@_isSaving" @onclick="CancelEdit"><MudIcon Icon="@Icons.Material.Filled.Close" /></button></div>
                @if (_editorError is not null)
                {
                    <div class="notice error-notice" role="alert">@_editorError</div>
                }
                <form class="editor-form" @onsubmit="SaveInstanceAsync" @onsubmit:preventDefault="true">
                    <fieldset disabled="@_isSaving">
                        <label>Instance name<input @bind="_draftName" maxlength="60" required autofocus placeholder="e.g. Main library" /></label>
                        <div class="mode-selector" role="radiogroup" aria-label="Stash mode">
                            <label><input type="radio" name="stash-mode" checked="@(!_draftManaged)" @onchange="() => _draftManaged = false" />External</label>
                            <label><input type="radio" name="stash-mode" checked="@_draftManaged" @onchange="() => _draftManaged = true" />Managed</label>
                        </div>
                        @if (_draftManaged)
                        {
                            <label>Stash installation folder<input @bind="_draftInstallation" required placeholder="C:\Servers\Stash" /></label>
                            <label>Port<input @bind="_draftPort" type="number" min="1024" max="65535" required /></label>
                            <label class="checkbox-label"><input type="checkbox" @bind="_draftAutostart" />Start with Personal Server Manager</label>
                        }
                        else
                        {
                            <label>Stash base URL<input @bind="_draftWebUrl" type="url" required placeholder="http://localhost:9999/" /></label>
                        }
                        <label>API key <span class="field-note">@(_editingId is null ? "Optional" : "Leave blank to keep the current key")</span><input @bind="_draftApiKey" type="password" autocomplete="new-password" /></label>
                        <p class="security-note">API keys are encrypted on this Windows account. Use HTTPS for Stash endpoints that cross an untrusted network.</p>
                        <div class="editor-actions"><button class="cancel-button" type="button" @onclick="CancelEdit">Cancel</button><button class="save-button" type="submit">@(_isSaving ? "Saving..." : "Save instance")</button></div>
                    </fieldset>
                </form>
                </MudFocusTrap>
            </section>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly BackendSelection _selection = new();
    private readonly Dictionary<Guid, StashObservation> _observations = [];
    private CancellationToken _token;
    private IReadOnlyList<StashInstance> _instances = [];
    private IReadOnlyList<HydrusInstance> _hydrusInstances = [];
    private IReadOnlyList<LocalLibraryInstance> _localLibraries = [];
    private int _comicInstanceCount;
    private int _swarmInstanceCount;
    private DateTimeOffset? _lastRefresh;
    private string _draftName = string.Empty;
    private string _draftGraphQlUrl = string.Empty;
    private string _draftWebUrl = string.Empty;
    private string _draftApiKey = string.Empty;
    private bool _draftManaged;
    private string _draftInstallation = string.Empty;
    private int _draftPort = 9999;
    private bool _draftAutostart;
    private string? _pageError;
    private string? _hydrusError;
    private string? _localError;
    private string? _editorError;
    private Guid? _editingId;
    private bool _isEditing;
    private bool _isSaving;
    private bool _disposed;
    private bool _scrollToDetails;

    private StashInstance? _selectedInstance => _selection.Type == "Stash"
        ? _instances.FirstOrDefault(instance => instance.Id == _selection.InstanceId) : null;

    protected override async Task OnInitializedAsync()
    {
        _selection.Changed += SelectionChanged;
        _token = _lifetime.Token;
        try
        {
            await LoadInstancesAsync();
            await ReloadHydrusAsync();
            await ReloadLocalAsync();
            await ReloadSwarmAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            _ = ObservePeriodicallyAsync();
        }
        if (_scrollToDetails && !_disposed)
        {
            _scrollToDetails = false;
            try { await JavaScript.InvokeVoidAsync("psmScrollBackendDetails"); }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task LoadInstancesAsync()
    {
        try
        {
            _instances = await InstanceStore.GetAllAsync(_token);
            if (_selection.Type == "Stash" && _selection.InstanceId is { } selectedId &&
                _instances.All(instance => instance.Id != selectedId))
            {
                _selection.Clear("Stash", selectedId);
            }
            _pageError = null;
        }
        catch (Exception exception) when (IsConfigurationFailure(exception))
        {
            _pageError = $"Stash configuration could not be loaded: {exception.Message}";
        }
    }

    private async Task RefreshObservationsAsync()
    {
        var snapshot = _instances;
        var observations = await Task.WhenAll(snapshot.Select(async instance =>
        {
            try
            {
                return await StashClient.ObserveAsync(instance, _token);
            }
            catch (OperationCanceledException) when (_token.IsCancellationRequested) { throw; }
            catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or InvalidDataException or JsonException)
            {
                return new StashObservation(instance.Id, instance.Name, false, DateTimeOffset.UtcNow, SafeError(exception));
            }
        }));
        if (!_disposed && ReferenceEquals(snapshot, _instances))
        {
            foreach (var observation in observations)
            {
                _observations[observation.InstanceId] = observation;
            }
            _lastRefresh = DateTimeOffset.UtcNow;
        }
    }

    private async Task ObservePeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            await RefreshObservationsAsync();
            if (!_disposed)
            {
                StateHasChanged();
            }

            while (await timer.WaitForNextTickAsync(_token))
            {
                await InvokeAsync(async () =>
                {
                    if (!_disposed && !_isSaving)
                    {
                        await RefreshObservationsAsync();
                        if (!_disposed)
                        {
                            StateHasChanged();
                        }
                    }
                });
            }
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (_disposed) { }
    }

    private void StartNewInstance()
    {
        _editingId = null;
        _draftName = string.Empty;
        _draftGraphQlUrl = "http://localhost:9999/graphql";
        _draftWebUrl = "http://localhost:9999/";
        _draftApiKey = string.Empty;
        _editorError = null;
        _draftManaged = false;
        _draftInstallation = string.Empty;
        _draftPort = 9999;
        _draftAutostart = false;
        _isEditing = true;
    }

    private void EditInstance(StashInstance instance)
    {
        if (ManagedBackends.GetStatus(instance.Id).IsRunning)
        {
            _pageError = "Stop Stash before editing its configuration.";
            return;
        }
        _editingId = instance.Id;
        _draftName = instance.Name;
        _draftGraphQlUrl = instance.GraphQlEndpoint.AbsoluteUri;
        _draftWebUrl = instance.WebUiUrl.AbsoluteUri;
        _draftApiKey = string.Empty;
        _editorError = null;
        _draftManaged = instance.IsManaged;
        _draftInstallation = instance.InstallationFolder ?? string.Empty;
        _draftPort = instance.Port;
        _draftAutostart = instance.StartWithApp;
        _isEditing = true;
    }

    private async Task SaveInstanceAsync()
    {
        if (_isSaving || _disposed)
        {
            return;
        }
        var baseUrl = _draftManaged ? $"http://127.0.0.1:{_draftPort}/" : _draftWebUrl;
        if (string.IsNullOrWhiteSpace(_draftName) || _draftName.Trim().Length > 60 ||
            !TryParseEndpoint(baseUrl, out var webUrl))
        {
            _editorError = "Enter a name (up to 60 characters) and valid HTTP or HTTPS URLs without embedded credentials.";
            return;
        }

        _isSaving = true;
        _editorError = null;
        try
        {
            var normalizedBase = new Uri(webUrl!.AbsoluteUri.TrimEnd('/') + "/");
            var existing = _editingId is null ? null : (await InstanceStore.GetAllAsync(_token)).FirstOrDefault(item => item.Id == _editingId);
            var instance = new StashInstance(_editingId ?? Guid.NewGuid(), _draftName.Trim(), new Uri(normalizedBase, "graphql"), normalizedBase, _draftApiKey,
                _draftManaged ? _draftInstallation.Trim() : null, _draftPort, _draftManaged && _draftAutostart)
            {
                JobSettings = existing?.JobSettings ?? new()
            };
            if (_editingId is null) await InstanceStore.SaveAsync(instance, _token);
            else await ManagedBackends.UpdateInstanceAsync(instance, _token);
            _draftApiKey = string.Empty;
            await LoadInstancesAsync();
            if (_instances.Any(item => item.Id == instance.Id))
                _selection.Select("Stash", instance.Id);
            _isEditing = false;
            await RefreshObservationsAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsConfigurationFailure(exception))
        {
            _editorError = $"Configuration was not saved: {exception.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RemoveInstanceAsync(StashInstance instance)
    {
        if (_isSaving || _disposed)
        {
            return;
        }
        _isSaving = true;
        try
        {
            var message = instance.IsManaged
                ? $"Remove {instance.Name} from this manager? The managed service will stop; local files will be kept."
                : $"Remove {instance.Name} from this manager? The external service will remain running; local files will be kept.";
            if (!await JavaScript.InvokeAsync<bool>("confirm", _token, message))
            {
                return;
            }
            await ManagedBackends.RemoveInstanceAsync("Stash", instance.Id, _token);
            _selection.Clear("Stash", instance.Id);
            _observations.Remove(instance.Id);
            await LoadInstancesAsync();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsConfigurationFailure(exception) || exception is JSException)
        {
            _pageError = $"Configuration was not removed: {exception.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void SelectInstance(Guid id) => _selection.Select("Stash", id);

    private void SelectionChanged()
    {
        if (!_disposed)
        {
            _scrollToDetails = _selection.Type is not null;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveStashAutostartAsync(bool enabled)
    {
        if (_selectedInstance is not { } instance) return;
        try
        {
            await InstanceStore.UpdateAsync(instance with { StartWithApp = enabled }, _token);
            await LoadInstancesAsync();
        }
        catch (Exception exception) when (IsConfigurationFailure(exception))
        {
            _pageError = exception is InvalidDataException && exception.Message == "The Stash instance no longer exists."
                ? exception.Message : "Could not save the autostart setting.";
        }
    }

    private async Task ReloadHydrusAsync()
    {
        try
        {
            _hydrusInstances = await HydrusStore.GetAllAsync(_token);
            _hydrusError = null;
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsConfigurationFailure(exception))
        {
            _hydrusError = "Hydrus configuration could not be loaded. Check the data directory and Windows account; existing data was not changed.";
        }
    }

    private async Task ReloadLocalAsync()
    {
        try
        {
            _localLibraries = await LocalStore.GetAllAsync(_token);
            _localError = null;
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsConfigurationFailure(exception))
        {
            _localError = "Local library configuration could not be loaded. Existing data was not changed.";
        }
    }

    private async Task ReloadSwarmAsync()
    {
        try
        {
            _swarmInstanceCount = (await SwarmStore.GetAllAsync(_token)).Count;
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception) when (IsConfigurationFailure(exception)) { }
    }

    private void CancelEdit()
    {
        if (!_isSaving)
        {
            _isEditing = false;
            _editorError = null;
            _draftApiKey = string.Empty;
        }
    }

    private void HandleEditorKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private static bool TryParseEndpoint(string value, out Uri? uri) =>
        Uri.TryCreate(value.Trim(), UriKind.Absolute, out uri) &&
        (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps) &&
        string.IsNullOrEmpty(uri.UserInfo) &&
        string.IsNullOrEmpty(uri.Query) &&
        string.IsNullOrEmpty(uri.Fragment);

    private static bool IsConfigurationFailure(Exception exception) => exception is
        IOException or InvalidDataException or UriFormatException or UnauthorizedAccessException or
        System.Security.Cryptography.CryptographicException or JsonException;

    private static string SafeError(Exception exception) => exception switch
    {
        TaskCanceledException => "Request timed out.",
        HttpRequestException => exception.Message,
        InvalidDataException => exception.Message,
        _ => "Stash returned an invalid response."
    };

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        _selection.Changed -= SelectionChanged;
        _draftApiKey = string.Empty;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}